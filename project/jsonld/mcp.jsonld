          "range": "McpListToolsResult",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpListToolsResultResponse",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpLoggingMessageNotification",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpLoggingMessageNotification",
      "description": "JSONRPCNotification of a log message passed from server to client. The client opts in by setting `\"io.modelcontextprotocol/logLevel\"` in a request's `_meta`.",
      "in_subset": [
        "notifications_message"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
