        {
          "name": "params",
          "description": "Parameters for a `notifications/message` notification.",
          "range": "McpLoggingMessageNotificationParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpLoggingMessageNotification",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpLoggingMessageNotificationParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpLoggingMessageNotificationParams",
      "description": "Parameters for a `notifications/message` notification.",
      "in_subset": [
        "notifications_message"
      ],
