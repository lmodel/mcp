          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "maximum",
          "description": "The largest value the field accepts.",
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "minimum",
          "description": "The smallest value the field accepts.",
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "kind",
