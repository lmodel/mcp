        "McpBooleanSchema"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpBooleanSchema__kind",
      "description": "The kind of object, always `boolean`.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "aliases": [
        "type"
      ],
      "slot_uri": "https://w3id.org/lmodel/mcp/kind",
      "alias": "kind",
