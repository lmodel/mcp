    {
      "name": "mcpAnnotations__intended_audience",
      "description": "Describes who the intended audience of this object or data is.\n\nIt can include multiple entries to indicate content useful for multiple audiences (e.g., `[\"user\", \"assistant\"]`).",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "aliases": [
        "audience"
      ],
      "slot_uri": "https://w3id.org/lmodel/mcp/intended_audience",
      "alias": "intended_audience",
      "owner": "McpAnnotations",
      "domain_of": [
        "McpAnnotations"
      ],
      "range": "McpRole",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpAnnotations__last_modified",
      "description": "The moment the resource was last modified, as an ISO 8601 formatted string.\n\nShould be an ISO 8601 formatted string (e.g., \"2025-01-12T15:00:58Z\").\n\nExamples: last activity timestamp in an open file, timestamp when the resource\nwas attached, etc.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/lastModified",
      "alias": "lastModified",
      "owner": "McpAnnotations",
      "domain_of": [
        "McpAnnotations"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpAnnotations__priority",
      "description": "Describes how important this data is for operating the server.\n\nA value of 1 means \"most important,\" and indicates that the data is\neffectively required, while 0 means \"least important,\" and indicates that\nthe data is entirely optional.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/priority",
      "alias": "priority",
      "owner": "McpAnnotations",
      "domain_of": [
        "McpAnnotations"
      ],
      "range": "float",
      "minimum_value": 0,
      "maximum_value": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpAudioContent__meta",
      "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/_meta",
      "alias": "_meta",
      "owner": "McpAudioContent",
      "domain_of": [
        "McpAudioContent"
      ],
      "range": "McpMetaObject",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpAudioContent__annotations",
      "description": "Optional annotations for the client.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/annotations",
      "alias": "annotations",
      "owner": "McpAudioContent",
      "domain_of": [
        "McpAudioContent"
      ],
      "range": "McpAnnotations",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpAudioContent__data",
      "description": "The base64-encoded audio data.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/data",
      "alias": "data",
      "owner": "McpAudioContent",
      "domain_of": [
        "McpAudioContent"
      ],
      "range": "McpBase64",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpAudioContent__mime_type",
      "description": "The MIME type of the audio. Different providers may support different audio types.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/mimeType",
      "alias": "mimeType",
      "owner": "McpAudioContent",
      "domain_of": [
        "McpAudioContent"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpAudioContent__kind",
      "description": "The kind of object, always `audio`.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "aliases": [
        "type"
      ],
      "slot_uri": "https://w3id.org/lmodel/mcp/kind",
      "alias": "kind",
      "owner": "McpAudioContent",
      "domain_of": [
        "McpAudioContent"
      ],
      "range": "string",
      "required": true,
      "equals_string": "audio",
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpBlobResourceContents__meta",
      "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/_meta",
      "alias": "_meta",
      "owner": "McpBlobResourceContents",
      "domain_of": [
        "McpBlobResourceContents"
      ],
      "range": "McpMetaObject",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpBlobResourceContents__blob",
      "description": "A base64-encoded string representing the binary data of the item.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/blob",
      "alias": "blob",
      "owner": "McpBlobResourceContents",
      "domain_of": [
        "McpBlobResourceContents"
      ],
      "range": "McpBase64",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpBlobResourceContents__mime_type",
      "description": "The MIME type of this resource, if known.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/mimeType",
      "alias": "mimeType",
      "owner": "McpBlobResourceContents",
      "domain_of": [
        "McpBlobResourceContents"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpBlobResourceContents__uri",
      "description": "The URI of this resource.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/uri",
      "alias": "uri",
      "owner": "McpBlobResourceContents",
      "domain_of": [
        "McpBlobResourceContents"
      ],
      "range": "uri",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "mcpBooleanSchema__default",
      "description": "The value the field takes when the user gives none.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "slot_uri": "https://w3id.org/lmodel/mcp/default",
      "alias": "default",
      "owner": "McpBooleanSchema",
