        "mcpLoggingMessageNotification__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `notifications/message`.",
          "required": true,
          "equals_string": "notifications/message",
