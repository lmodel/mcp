          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "enum_names",
          "description": "(Legacy) Display names for enum values.\nNon-standard according to JSON schema 2020-12.",
          "alias": "enumNames",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "kind",
          "description": "The kind of object, always `string`.",
          "aliases": [
