    {
      "name": "McpSubscriptionFilter",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionFilter",
      "description": "The set of notification types a client may opt in to on a\n{@link SubscriptionsListenRequestsubscriptions/listen} request.\n\nEach notification type is **opt-in**; the server **MUST NOT** send\nnotification types the client has not explicitly requested here.",
      "in_subset": [
        "subscriptions_listen"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SubscriptionFilter"
      ],
      "slots": [
        "mcpSubscriptionFilter__prompts_list_changed",
        "mcpSubscriptionFilter__resource_subscriptions",
        "mcpSubscriptionFilter__resources_list_changed",
        "mcpSubscriptionFilter__tools_list_changed"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "prompts_list_changed",
          "description": "If true, receive {@link PromptListChangedNotificationnotifications/prompts/list_changed}.",
          "alias": "promptsListChanged",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "resource_subscriptions",
          "description": "Subscribe to {@link ResourceUpdatedNotificationnotifications/resources/updated} for these resource URIs.\nReplaces the former `resources/subscribe` RPC.",
          "alias": "resourceSubscriptions",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "resources_list_changed",
          "description": "If true, receive {@link ResourceListChangedNotificationnotifications/resources/list_changed}.",
          "alias": "resourcesListChanged",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "tools_list_changed",
          "description": "If true, receive {@link ToolListChangedNotificationnotifications/tools/list_changed}.",
          "alias": "toolsListChanged",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionFilter",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpSubscriptionsAcknowledgedNotification",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsAcknowledgedNotification",
      "description": "Sent by the server to acknowledge that a\n{@link SubscriptionsListenRequestsubscriptions/listen} subscription has been\nestablished and to report which notification types it agreed to honor.\n\nThis notification MUST be the first message the server sends carrying the\nsubscription's ID in `io.modelcontextprotocol/subscriptionId`. The server MUST\nNOT send any notification on the subscription before acknowledging it. On\nstdio, where every subscription shares one channel, this ordering is defined\nper subscription ID and not per channel: messages belonging to other\nsubscriptions MAY be interleaved before it.",
      "in_subset": [
        "notifications_subscriptions_acknowledged"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SubscriptionsAcknowledgedNotification"
      ],
      "is_a": "McpJSONRPCNotification",
      "slots": [
        "mcpSubscriptionsAcknowledgedNotification__jsonrpc",
        "mcpSubscriptionsAcknowledgedNotification__method",
        "mcpSubscriptionsAcknowledgedNotification__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `notifications/subscriptions/acknowledged`.",
          "required": true,
          "equals_string": "notifications/subscriptions/acknowledged",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Parameters for a {@link SubscriptionsAcknowledgedNotificationnotifications/subscriptions/acknowledged} notification.",
          "range": "McpSubscriptionsAcknowledgedNotificationParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsAcknowledgedNotification",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpSubscriptionsAcknowledgedNotificationParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsAcknowledgedNotificationParams",
      "description": "Parameters for a {@link SubscriptionsAcknowledgedNotificationnotifications/subscriptions/acknowledged} notification.",
      "in_subset": [
        "notifications_subscriptions_acknowledged"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SubscriptionsAcknowledgedNotificationParams"
      ],
      "is_a": "McpNotificationParams",
      "slots": [
        "mcpSubscriptionsAcknowledgedNotificationParams__meta",
        "mcpSubscriptionsAcknowledgedNotificationParams__notifications"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional notification-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpNotificationMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "notifications",
          "description": "The subset of requested notification types the server agreed to honor.\nOnly includes notification types the server actually supports; if the\nclient requested an unsupported type (e.g., `promptsListChanged` when\nthe server has no prompts), it is omitted from this set.",
          "range": "McpSubscriptionFilter",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsAcknowledgedNotificationParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpSubscriptionsListenRequest",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenRequest",
      "description": "Sent from the client to open a long-lived channel for receiving notifications\noutside the context of a specific request. Replaces the previous HTTP GET\nendpoint and ensures consistent behavior between HTTP and STDIO.",
      "in_subset": [
        "subscriptions_listen"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SubscriptionsListenRequest"
      ],
      "is_a": "McpJSONRPCRequest",
      "slots": [
        "mcpSubscriptionsListenRequest__identifier",
        "mcpSubscriptionsListenRequest__jsonrpc",
        "mcpSubscriptionsListenRequest__method",
        "mcpSubscriptionsListenRequest__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `subscriptions/listen`.",
          "required": true,
          "equals_string": "subscriptions/listen",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Parameters for a {@link SubscriptionsListenRequestsubscriptions/listen} request.",
          "range": "McpSubscriptionsListenRequestParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenRequest",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpSubscriptionsListenRequestParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenRequestParams",
      "description": "Parameters for a {@link SubscriptionsListenRequestsubscriptions/listen} request.",
      "in_subset": [
        "subscriptions_listen"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SubscriptionsListenRequestParams"
      ],
      "is_a": "McpRequestParams",
      "slots": [
        "mcpSubscriptionsListenRequestParams__meta",
        "mcpSubscriptionsListenRequestParams__notifications"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional request-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpRequestMetaObject",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "notifications",
          "description": "The notifications the client opts in to on this stream. The server\n**MUST NOT** send notification types the client has not explicitly\nrequested.",
          "range": "McpSubscriptionFilter",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenRequestParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpSubscriptionsListenResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenResult",
      "description": "The response to a {@link SubscriptionsListenRequestsubscriptions/listen}\nrequest, signalling that the subscription has ended gracefully (for example,\nduring server shutdown). Because the listen stream is long-lived, this result\nis sent only when the server tears the subscription down; an abrupt transport\nclose carries no response. The result body is otherwise empty.",
      "in_subset": [
        "subscriptions_listen"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SubscriptionsListenResult"
      ],
      "is_a": "McpResult",
      "slots": [
        "mcpSubscriptionsListenResult__meta",
        "mcpSubscriptionsListenResult__result_type"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link ResultMetaObject} with the subscription-stream identifier carried by a\n{@link SubscriptionsListenResult}. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpSubscriptionsListenResultMetaObject",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "result_type",
          "description": "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`.",
          "alias": "resultType",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpSubscriptionsListenResultMetaObject",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenResultMetaObject",
      "description": "Extends {@link ResultMetaObject} with the subscription-stream identifier carried by a\n{@link SubscriptionsListenResult}. All key naming rules from `MetaObject` apply.",
      "in_subset": [
        "subscriptions_listen"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SubscriptionsListenResultMetaObject"
      ],
      "is_a": "McpResultMetaObject",
      "slots": [
        "mcpSubscriptionsListenResultMetaObject__mcp_server_info",
        "mcpSubscriptionsListenResultMetaObject__mcp_subscription_id"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "mcp_server_info",
          "description": "Identifies the server software producing the response. Servers SHOULD\ninclude this field on every response unless specifically configured not\nto do so.\n\nThe {@link Implementation} schema requires `name` and `version`; other\nfields are optional.\n\nThe value is self-reported by the server and is not verified by the\nprotocol. It is intended for display, logging, and debugging. Clients\nSHOULD NOT use it to change their behavior, and SHOULD NOT rely on it for\nsecurity decisions.",
          "aliases": [
            "io.modelcontextprotocol/serverInfo"
          ],
          "range": "McpImplementation",
          "@type": "SlotDefinition"
        },
        {
          "name": "mcp_subscription_id",
          "description": "Identifies the subscription stream this response closes, so the client can\ncorrelate it with the originating subscription \u2014 mirroring the same key on\nthe stream's notifications. The value is the JSON-RPC ID of the\n`subscriptions/listen` request that opened the stream (and equals this\nresponse's `id`).",
          "aliases": [
            "io.modelcontextprotocol/subscriptionId"
          ],
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenResultMetaObject",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpSubscriptionsListenResultResponse",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenResultResponse",
      "description": "A successful response from the server for a {@link SubscriptionsListenRequestsubscriptions/listen}\nrequest, sent when the server tears the subscription down gracefully.",
      "in_subset": [
        "subscriptions_listen"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SubscriptionsListenResultResponse"
      ],
      "is_a": "McpJSONRPCResultResponse",
      "slots": [
        "mcpSubscriptionsListenResultResponse__identifier",
        "mcpSubscriptionsListenResultResponse__jsonrpc",
        "mcpSubscriptionsListenResultResponse__result"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "result",
          "description": "The response to a {@link SubscriptionsListenRequestsubscriptions/listen}\nrequest, signalling that the subscription has ended gracefully (for example,\nduring server shutdown). Because the listen stream is long-lived, this result\nis sent only when the server tears the subscription down; an abrupt transport\nclose carries no response. The result body is otherwise empty.",
          "range": "McpSubscriptionsListenResult",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpSubscriptionsListenResultResponse",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpTextContent",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpTextContent",
      "description": "Text provided to or from an LLM.",
      "in_subset": [
        "content"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:TextContent"
      ],
      "slots": [
        "mcpTextContent__meta",
        "mcpTextContent__annotations",
        "mcpTextContent__text",
        "mcpTextContent__kind"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "annotations",
          "description": "Optional annotations for the client.",
          "range": "McpAnnotations",
          "@type": "SlotDefinition"
        },
        {
          "name": "text",
          "description": "The text content of the message.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "kind",
          "description": "The kind of object, always `text`.",
          "aliases": [
            "type"
          ],
          "required": true,
          "equals_string": "text",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpTextContent",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpTextResourceContents",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpTextResourceContents",
      "description": "MCP's `TextResourceContents`.",
      "in_subset": [
        "content"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:TextResourceContents"
      ],
      "is_a": "McpResourceContents",
      "slots": [
        "mcpTextResourceContents__meta",
        "mcpTextResourceContents__mime_type",
        "mcpTextResourceContents__text",
        "mcpTextResourceContents__uri"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "mime_type",
          "description": "The MIME type of this resource, if known.",
          "alias": "mimeType",
          "@type": "SlotDefinition"
        },
        {
          "name": "text",
          "description": "The text of the item. This must only be set if the item can actually be represented as text (not binary data).",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "uri",
          "description": "The URI of this resource.",
          "range": "uri",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpTextResourceContents",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpTitledMultiSelectEnumSchema",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpTitledMultiSelectEnumSchema",
      "description": "Schema for multiple-selection enumeration with display titles for each option.",
      "in_subset": [
        "elicitation_create"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
