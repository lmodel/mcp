          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `tools/call`.",
