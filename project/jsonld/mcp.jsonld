    {
      "name": "McpServerNotification",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpServerNotification",
      "description": "One of `CancelledNotification`, `ProgressNotification`, `ResourceListChangedNotification`, `SubscriptionsAcknowledgedNotification`, `ResourceUpdatedNotification`, `PromptListChangedNotification`, `ToolListChangedNotification`, `LoggingMessageNotification`.",
      "from_schema": "https://w3id.org/lmodel/mcp",
