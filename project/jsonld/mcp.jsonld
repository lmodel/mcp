          "@type": "AnonymousSlotExpression"
        },
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpInternalError",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpInternalError",
      "description": "A JSON-RPC error indicating that an internal error occurred on the receiver. This error is returned when the receiver encounters an unexpected condition that prevents it from fulfilling the request.",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:InternalError"
      ],
      "is_a": "McpError",
      "slots": [
        "mcpInternalError__code",
        "mcpInternalError__data",
        "mcpInternalError__message"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "code",
          "description": "The error type that occurred.",
          "range": "integer",
          "required": true,
          "equals_number": -32603,
          "@type": "SlotDefinition"
        },
        {
          "name": "data",
          "description": "Additional information about the error. The value of this member is defined by the sender (e.g. detailed error information, nested errors etc.).",
          "range": "McpJSONValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "message",
          "description": "A short description of the error. The message SHOULD be limited to a concise single sentence.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpInternalError",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpInvalidParamsError",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpInvalidParamsError",
      "description": "A JSON-RPC error indicating that the method parameters are invalid or malformed.\n\nIn MCP, this error is returned in various contexts when request parameters fail validation:\n\n- **Tools**: Unknown tool name or invalid tool arguments\n- **Prompts**: Unknown prompt name or missing required arguments\n- **Pagination**: Invalid or expired cursor values\n- **Logging**: Invalid log level\n- **Elicitation**: Server requests an elicitation mode not declared in client capabilities\n- **Sampling**: Missing tool result or tool results mixed with other content",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:InvalidParamsError"
      ],
      "is_a": "McpError",
      "slots": [
        "mcpInvalidParamsError__code",
        "mcpInvalidParamsError__data",
        "mcpInvalidParamsError__message"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "code",
          "description": "The error type that occurred.",
          "range": "integer",
          "required": true,
          "equals_number": -32602,
          "@type": "SlotDefinition"
        },
        {
          "name": "data",
          "description": "Additional information about the error. The value of this member is defined by the sender (e.g. detailed error information, nested errors etc.).",
          "range": "McpJSONValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "message",
          "description": "A short description of the error. The message SHOULD be limited to a concise single sentence.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpInvalidParamsError",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpInvalidRequestError",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpInvalidRequestError",
      "description": "A JSON-RPC error indicating that the request is not a valid request object. This error is returned when the message structure does not conform to the JSON-RPC 2.0 specification requirements for a request (e.g., missing required fields like `jsonrpc` or `method`, or using invalid types for these fields).",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:InvalidRequestError"
      ],
      "is_a": "McpError",
      "slots": [
        "mcpInvalidRequestError__code",
        "mcpInvalidRequestError__data",
        "mcpInvalidRequestError__message"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "code",
          "description": "The error type that occurred.",
          "range": "integer",
          "required": true,
          "equals_number": -32600,
          "@type": "SlotDefinition"
        },
        {
          "name": "data",
          "description": "Additional information about the error. The value of this member is defined by the sender (e.g. detailed error information, nested errors etc.).",
          "range": "McpJSONValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "message",
          "description": "A short description of the error. The message SHOULD be limited to a concise single sentence.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpInvalidRequestError",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
