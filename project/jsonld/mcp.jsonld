          "is_a": "McpElicitRequestURLParams",
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "McpElicitRequestURLParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpElicitRequestURLParams",
      "description": "The parameters for a request to elicit information from the user via a URL in the client.",
      "in_subset": [
        "elicitation_create"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ElicitRequestURLParams"
      ],
      "slots": [
        "McpElicitRequestURLParams_url",
        "mcpElicitRequestURLParams__message",
        "mcpElicitRequestURLParams__mode"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "message",
          "description": "The message to present to the user explaining why the interaction is needed.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "mode",
          "description": "The elicitation mode.",
          "required": true,
          "equals_string": "url",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpElicitRequestURLParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpElicitResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpElicitResult",
      "description": "The result returned by the client for an {@link ElicitRequestelicitation/create} request.",
      "in_subset": [
        "elicitation_create"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ElicitResult"
      ],
      "slots": [
        "mcpElicitResult__action",
        "mcpElicitResult__content"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "action",
          "description": "The user action in response to the elicitation.\n- `\"accept\"`: User submitted the form/confirmed the action\n- `\"decline\"`: User explicitly declined the action\n- `\"cancel\"`: User dismissed without making an explicit choice",
          "range": "McpElicitResultAction",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "content",
          "description": "The submitted form data, only present when action is `\"accept\"` and mode was `\"form\"`.\nContains values matching the requested schema.\nOmitted for out-of-band mode responses.",
          "range": "McpElicitResultContent",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpElicitResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpElicitResultContent",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpElicitResultContent",
      "description": "The submitted form data, only present when action is `\"accept\"` and mode was `\"form\"`.\nContains values matching the requested schema.\nOmitted for out-of-band mode responses.",
      "in_subset": [
        "elicitation_create"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ElicitResult/properties/content"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpElicitResultContent",
      "extra_slots": {
        "range_expression": {
          "any_of": [
            {
              "range": "string",
              "multivalued": true,
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "boolean",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "AnonymousSlotExpression"
        },
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpEmbeddedResource",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpEmbeddedResource",
      "description": "The contents of a resource, embedded into a prompt or tool call result.\n\nIt is up to the client how best to render embedded resources for the benefit\nof the LLM and/or the user.",
      "in_subset": [
        "content"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:EmbeddedResource"
      ],
      "slots": [
        "mcpEmbeddedResource__meta",
        "mcpEmbeddedResource__annotations",
        "mcpEmbeddedResource__resource_contents",
        "mcpEmbeddedResource__kind"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "annotations",
          "description": "Optional annotations for the client.",
          "range": "McpAnnotations",
          "@type": "SlotDefinition"
        },
        {
          "name": "resource_contents",
          "description": "The resource's contents, as text or as binary data.",
          "aliases": [
            "resource"
          ],
          "required": true,
          "any_of": [
            {
              "range": "McpTextResourceContents",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpBlobResourceContents",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "kind",
          "description": "The kind of object, always `resource`.",
          "aliases": [
            "type"
          ],
          "required": true,
          "equals_string": "resource",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpEmbeddedResource",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpEmptyResult",
