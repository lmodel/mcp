      "description": "Parameters for a `prompts/get` request.",
      "in_subset": [
        "prompts_get"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:GetPromptRequestParams"
      ],
      "is_a": "McpInputResponseRequestParams",
      "slots": [
        "McpGetPromptRequestParams_name",
        "mcpGetPromptRequestParams__meta",
        "mcpGetPromptRequestParams__arguments",
        "mcpGetPromptRequestParams__input_responses",
        "mcpGetPromptRequestParams__request_state"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional request-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpRequestMetaObject",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "arguments",
          "description": "Arguments to use for templating the prompt.",
