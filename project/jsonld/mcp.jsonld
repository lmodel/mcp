      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:PaginatedRequestParams"
      ],
      "is_a": "McpRequestParams",
      "slots": [
        "mcpPaginatedRequestParams__meta",
        "mcpPaginatedRequestParams__cursor"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional request-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpRequestMetaObject",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cursor",
          "description": "An opaque token representing the current pagination position.\nIf provided, the server should return results starting after this cursor.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpPaginatedRequestParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpPaginatedResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpPaginatedResult",
      "description": "MCP's `PaginatedResult`.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:PaginatedResult"
      ],
      "is_a": "McpResult",
      "slots": [
        "mcpPaginatedResult__meta",
        "mcpPaginatedResult__next_cursor",
        "mcpPaginatedResult__result_type"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpResultMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "next_cursor",
          "description": "An opaque token representing the pagination position after the last returned result.\nIf present, there may be more results available.",
          "alias": "nextCursor",
          "@type": "SlotDefinition"
        },
        {
          "name": "result_type",
          "description": "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`.",
          "alias": "resultType",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpPaginatedResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpParseError",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpParseError",
      "description": "A JSON-RPC error indicating that invalid JSON was received by the server. This error is returned when the server cannot parse the JSON text of a message.",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ParseError"
      ],
      "is_a": "McpError",
      "slots": [
        "mcpParseError__code",
        "mcpParseError__data",
        "mcpParseError__message"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "code",
          "description": "The error type that occurred.",
          "range": "integer",
          "required": true,
          "equals_number": -32700,
          "@type": "SlotDefinition"
        },
        {
          "name": "data",
          "description": "Additional information about the error. The value of this member is defined by the sender (e.g. detailed error information, nested errors etc.).",
          "range": "McpJSONValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "message",
          "description": "A short description of the error. The message SHOULD be limited to a concise single sentence.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpParseError",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpPrimitiveSchemaDefinition",
