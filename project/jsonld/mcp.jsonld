    },
    {
      "name": "McpListPromptsRequest",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpListPromptsRequest",
      "description": "Sent from the client to request a list of prompts and prompt templates the server has.",
      "in_subset": [
        "prompts_list"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ListPromptsRequest"
      ],
      "is_a": "McpPaginatedRequest",
      "slots": [
        "mcpListPromptsRequest__identifier",
        "mcpListPromptsRequest__jsonrpc",
        "mcpListPromptsRequest__method",
        "mcpListPromptsRequest__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `prompts/list`.",
          "required": true,
          "equals_string": "prompts/list",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Common params for paginated requests.",
          "range": "McpPaginatedRequestParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpListPromptsRequest",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpListPromptsResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpListPromptsResult",
      "description": "The result returned by the server for a {@link ListPromptsRequestprompts/list} request.",
      "in_subset": [
        "prompts_list"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ListPromptsResult"
      ],
      "is_a": "McpPaginatedResult",
      "mixins": [
        "McpCacheableResult"
      ],
      "slots": [
        "mcpListPromptsResult__meta",
        "mcpListPromptsResult__cache_scope",
        "mcpListPromptsResult__next_cursor",
        "mcpListPromptsResult__prompts",
        "mcpListPromptsResult__result_type",
        "mcpListPromptsResult__ttl_ms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpResultMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "cache_scope",
          "description": "Indicates the intended scope of the cached response, analogous to HTTP\n`Cache-Control: public` vs `Cache-Control: private`.\n\n- `\"public\"`: The response does not contain user-specific data. Any\n  client or intermediary (e.g., shared gateway, caching proxy) MAY cache\n  the response and serve it across authorization contexts.\n- `\"private\"`: The response MAY be cached and reused only within the\n  same authorization context. Caches MUST NOT be shared across\n  authorization contexts (e.g., a different access token requires a\n  different cache).",
          "alias": "cacheScope",
          "range": "McpCacheScope",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "next_cursor",
          "description": "An opaque token representing the pagination position after the last returned result.\nIf present, there may be more results available.",
          "alias": "nextCursor",
          "@type": "SlotDefinition"
        },
        {
          "name": "prompts",
          "description": "A prompt or prompt template that the server offers.",
          "range": "McpPrompt",
          "required": true,
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "result_type",
          "description": "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`.",
          "alias": "resultType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ttl_ms",
          "description": "A hint from the server indicating how long (in milliseconds) the\nclient MAY cache this response before re-fetching. Semantics are\nanalogous to HTTP Cache-Control max-age.\n\n- If 0, The response SHOULD be considered immediately stale,\n  The client MAY re-fetch every time the result is needed.\n- If positive, the client SHOULD consider the result fresh for this many\n  milliseconds after receiving the response.",
          "alias": "ttlMs",
          "range": "integer",
          "required": true,
          "minimum_value": 0,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpListPromptsResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpListPromptsResultResponse",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpListPromptsResultResponse",
