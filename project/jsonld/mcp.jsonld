    {
      "name": "McpElicitRequestParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpElicitRequestParams",
      "description": "The parameters for a request to elicit additional information from the user via the client.",
      "in_subset": [
        "elicitation_create"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ElicitRequestParams"
