      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpMetaObject",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpMetaObject",
      "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
      "in_subset": [
        "common_types"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:MetaObject"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpMetaObject",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpMethodNotFoundError",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpMethodNotFoundError",
      "description": "A JSON-RPC error indicating that the requested method does not exist or is not available.\n\nIn MCP, a server returns this error when a client invokes a method the server does not implement \u2014 either a genuinely unknown method, or one gated behind a server capability the server did not advertise (e.g., calling `prompts/list` when the `prompts` capability was not advertised).\n\nA request that requires a client capability the client did not declare is signalled instead by {@link MissingRequiredClientCapabilityError} (`-32021`).",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:MethodNotFoundError"
      ],
      "is_a": "McpError",
      "slots": [
        "mcpMethodNotFoundError__code",
        "mcpMethodNotFoundError__data",
        "mcpMethodNotFoundError__message"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "code",
          "description": "The error type that occurred.",
          "range": "integer",
          "required": true,
          "equals_number": -32601,
          "@type": "SlotDefinition"
        },
        {
          "name": "data",
          "description": "Additional information about the error. The value of this member is defined by the sender (e.g. detailed error information, nested errors etc.).",
          "range": "McpJSONValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "message",
          "description": "A short description of the error. The message SHOULD be limited to a concise single sentence.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpMethodNotFoundError",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpMissingRequiredClientCapabilityError",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpMissingRequiredClientCapabilityError",
      "description": "Returned when processing a request requires a capability the client did not\ndeclare in `clientCapabilities`. For HTTP, the response status code MUST be\n`400 Bad Request`.",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:MissingRequiredClientCapabilityError"
      ],
      "is_a": "McpJSONRPCErrorResponse",
      "slots": [
        "mcpMissingRequiredClientCapabilityError__error",
        "mcpMissingRequiredClientCapabilityError__identifier",
        "mcpMissingRequiredClientCapabilityError__jsonrpc"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "error",
          "description": "The error the request ended with.",
          "range": "McpMissingRequiredClientCapabilityErrorError",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpMissingRequiredClientCapabilityError",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpMissingRequiredClientCapabilityErrorError",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpMissingRequiredClientCapabilityErrorError",
      "description": "MCP's `Error`, with the code and data this error carries.",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:MissingRequiredClientCapabilityError/properties/error/allOf/1"
      ],
      "is_a": "McpError",
      "slots": [
        "mcpError__message",
        "mcpMissingRequiredClientCapabilityErrorError__code",
        "mcpMissingRequiredClientCapabilityErrorError__data"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "code",
          "description": "The error code, always `-32021`.",
          "range": "integer",
          "required": true,
          "equals_number": -32021,
          "@type": "SlotDefinition"
        },
        {
          "name": "data",
          "description": "Details of the error.",
          "range": "McpMissingRequiredClientCapabilityErrorErrorData",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpMissingRequiredClientCapabilityErrorError",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpMissingRequiredClientCapabilityErrorErrorData",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpMissingRequiredClientCapabilityErrorErrorData",
      "description": "The object MCP's `MissingRequiredClientCapabilityError` holds under `data`.",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:MissingRequiredClientCapabilityError/properties/error/allOf/1/properties/data"
      ],
      "slots": [
        "mcpMissingRequiredClientCapabilityErrorErrorData__required_capabilities"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "required_capabilities",
          "description": "The capabilities the server requires from the client to process this request.",
          "alias": "requiredCapabilities",
          "range": "McpClientCapabilities",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpMissingRequiredClientCapabilityErrorErrorData",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpModelHint",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpModelHint",
      "description": "Hints to use for model selection.\n\nKeys not declared here are currently left unspecified by the spec and are up\nto the client to interpret.",
      "in_subset": [
        "sampling_createmessage"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ModelHint"
      ],
      "slots": [
        "McpModelHint_name"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpModelHint",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpModelPreferences",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpModelPreferences",
      "description": "The server's preferences for model selection, requested of the client during sampling.\n\nBecause LLMs can vary along multiple dimensions, choosing the \"best\" model is\nrarely straightforward.  Different models excel in different areas\u2014some are\nfaster but less capable, others are more capable but more expensive, and so\non. This interface allows servers to express their priorities across multiple\ndimensions to help clients make an appropriate selection for their use case.\n\nThese preferences are always advisory. The client MAY ignore them. It is also\nup to the client to decide how to interpret these preferences and how to\nbalance them against other considerations.",
      "in_subset": [
        "sampling_createmessage"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ModelPreferences"
      ],
      "slots": [
        "mcpModelPreferences__cost_priority",
        "mcpModelPreferences__hints",
        "mcpModelPreferences__intelligence_priority",
        "mcpModelPreferences__speed_priority"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cost_priority",
          "description": "How much to prioritize cost when selecting a model. A value of 0 means cost\nis not important, while a value of 1 means cost is the most important\nfactor.",
          "alias": "costPriority",
          "range": "float",
          "minimum_value": 0,
          "maximum_value": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "hints",
          "description": "Optional hints to use for model selection.\n\nIf multiple hints are specified, the client MUST evaluate them in order\n(such that the first match is taken).\n\nThe client SHOULD prioritize these hints over the numeric priorities, but\nMAY still use the priorities to select from ambiguous matches.",
          "range": "McpModelHint",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "intelligence_priority",
          "description": "How much to prioritize intelligence and capabilities when selecting a\nmodel. A value of 0 means intelligence is not important, while a value of 1\nmeans intelligence is the most important factor.",
          "alias": "intelligencePriority",
          "range": "float",
          "minimum_value": 0,
          "maximum_value": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "speed_priority",
          "description": "How much to prioritize sampling speed (latency) when selecting a model. A\nvalue of 0 means speed is not important, while a value of 1 means speed is\nthe most important factor.",
          "alias": "speedPriority",
          "range": "float",
          "minimum_value": 0,
          "maximum_value": 1,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpModelPreferences",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpMultiSelectEnumSchema",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpMultiSelectEnumSchema",
