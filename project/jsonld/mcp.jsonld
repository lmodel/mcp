      },
      "any_of": [
        {
          "is_a": "McpStringSchema",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpNumberSchema",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpBooleanSchema",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpUntitledSingleSelectEnumSchema",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpTitledSingleSelectEnumSchema",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpUntitledMultiSelectEnumSchema",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpTitledMultiSelectEnumSchema",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpLegacyTitledEnumSchema",
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "McpProgressNotification",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpProgressNotification",
      "description": "An out-of-band notification used to inform the receiver of a progress update for a long-running request.",
      "in_subset": [
        "notifications_progress"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ProgressNotification"
      ],
      "is_a": "McpJSONRPCNotification",
      "slots": [
        "mcpProgressNotification__jsonrpc",
        "mcpProgressNotification__method",
        "mcpProgressNotification__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `notifications/progress`.",
          "required": true,
          "equals_string": "notifications/progress",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Parameters for a {@link ProgressNotificationnotifications/progress} notification.",
          "range": "McpProgressNotificationParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpProgressNotification",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpProgressNotificationParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpProgressNotificationParams",
      "description": "Parameters for a {@link ProgressNotificationnotifications/progress} notification.",
      "in_subset": [
        "notifications_progress"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ProgressNotificationParams"
      ],
      "is_a": "McpNotificationParams",
      "slots": [
        "mcpProgressNotificationParams__meta",
        "mcpProgressNotificationParams__message",
        "mcpProgressNotificationParams__progress",
        "mcpProgressNotificationParams__progress_token",
        "mcpProgressNotificationParams__total"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional notification-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpNotificationMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "message",
          "description": "An optional message describing the current progress.",
          "@type": "SlotDefinition"
        },
        {
          "name": "progress",
          "description": "The progress thus far. This should increase every time progress is made, even if the total is unknown.",
          "range": "float",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "progress_token",
          "description": "The progress token which was given in the initial request, used to associate this notification with the request that is proceeding.",
          "alias": "progressToken",
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "total",
          "description": "Total number of items to process (or total progress required), if known.",
          "range": "float",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpProgressNotificationParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpPrompt",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpPrompt",
      "description": "A prompt or prompt template that the server offers.",
      "in_subset": [
        "prompts_list"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:Prompt"
      ],
      "is_a": "McpBaseMetadata",
      "mixins": [
        "McpIcons"
      ],
      "slots": [
        "McpPrompt_description",
        "McpPrompt_name",
        "McpPrompt_title",
        "mcpPrompt__meta",
        "mcpPrompt__arguments",
        "mcpPrompt__icons"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "arguments",
          "description": "A list of arguments to use for templating the prompt.",
          "range": "McpPromptArgument",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "icons",
          "description": "Optional set of sized icons that the client can display in a user interface.\n\nClients that support rendering icons MUST support at least the following MIME types:\n- `image/png` - PNG images (safe, universal compatibility)\n- `image/jpeg` (and `image/jpg`) - JPEG images (safe, universal compatibility)\n\nClients that support rendering icons SHOULD also support:\n- `image/svg+xml` - SVG images (scalable but requires security precautions)\n- `image/webp` - WebP images (modern, efficient format)",
          "range": "McpIcon",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpPrompt",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpPromptArgument",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpPromptArgument",
      "description": "Describes an argument that a prompt can accept.",
      "in_subset": [
        "prompts_list"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:PromptArgument"
      ],
      "is_a": "McpBaseMetadata",
      "slots": [
        "McpPromptArgument_description",
        "McpPromptArgument_name",
        "McpPromptArgument_title",
        "mcpPromptArgument__required"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "required",
          "description": "Whether this argument must be provided.",
          "slot_uri": "schema:valueRequired",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpPromptArgument",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpPromptListChangedNotification",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpPromptListChangedNotification",
      "description": "An optional notification from the server to the client, informing it that the list of prompts it offers has changed. This is only delivered on a {@link SubscriptionsListenRequestsubscriptions/listen} stream when the client requested it via the `promptsListChanged` filter field.",
      "in_subset": [
        "notifications_prompts_list_changed"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:PromptListChangedNotification"
      ],
      "is_a": "McpJSONRPCNotification",
      "slots": [
        "mcpPromptListChangedNotification__jsonrpc",
        "mcpPromptListChangedNotification__method",
        "mcpPromptListChangedNotification__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `notifications/prompts/list_changed`.",
          "required": true,
          "equals_string": "notifications/prompts/list_changed",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Common params for any notification.",
          "range": "McpNotificationParams",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpPromptListChangedNotification",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpPromptMessage",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpPromptMessage",
      "description": "Describes a message returned as part of a prompt.\n\nThis is similar to {@link SamplingMessage}, but also supports the embedding of\nresources from the MCP server.",
      "in_subset": [
        "prompts_get"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:PromptMessage"
      ],
      "slots": [
        "mcpPromptMessage__content",
        "mcpPromptMessage__role"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "content",
          "description": "The content the message carries.",
          "range": "McpContentBlock",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "role",
          "description": "The sender or recipient of messages and data in a conversation.",
          "range": "McpRole",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpPromptMessage",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpPromptReference",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpPromptReference",
      "description": "Identifies a prompt.",
      "in_subset": [
        "completion_complete"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:PromptReference"
      ],
      "is_a": "McpBaseMetadata",
      "slots": [
        "McpPromptReference_name",
        "McpPromptReference_title",
        "mcpPromptReference__kind"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "kind",
          "description": "The kind of object, always `ref/prompt`.",
          "aliases": [
            "type"
          ],
          "required": true,
          "equals_string": "ref/prompt",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpPromptReference",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpReadResourceRequest",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpReadResourceRequest",
      "description": "Sent from the client to the server, to read a specific resource URI.",
      "in_subset": [
        "resources_read"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ReadResourceRequest"
      ],
      "is_a": "McpJSONRPCRequest",
      "slots": [
        "mcpReadResourceRequest__identifier",
        "mcpReadResourceRequest__jsonrpc",
        "mcpReadResourceRequest__method",
        "mcpReadResourceRequest__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `resources/read`.",
          "required": true,
          "equals_string": "resources/read",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Parameters for a `resources/read` request.",
          "range": "McpReadResourceRequestParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpReadResourceRequest",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpReadResourceRequestParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpReadResourceRequestParams",
      "description": "Parameters for a `resources/read` request.",
      "in_subset": [
        "resources_read"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ReadResourceRequestParams"
      ],
      "is_a": "McpResourceRequestParams",
      "mixins": [
        "McpInputResponseRequestParams"
      ],
      "slots": [
        "mcpReadResourceRequestParams__meta",
        "mcpReadResourceRequestParams__input_responses",
        "mcpReadResourceRequestParams__request_state",
        "mcpReadResourceRequestParams__uri"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional request-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpRequestMetaObject",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "input_responses",
          "description": "A map of client responses to server-initiated requests.\nKeys correspond to the keys in the {@link InputRequests} map;\nvalues are the client's result for each request.",
          "alias": "inputResponses",
          "range": "McpInputResponses",
          "@type": "SlotDefinition"
        },
        {
          "name": "request_state",
          "description": "State the server returned with an input-required result, sent back unchanged when the request is retried.",
          "alias": "requestState",
          "@type": "SlotDefinition"
        },
        {
          "name": "uri",
          "description": "The URI of the resource. The URI can use any protocol; it is up to the server how to interpret it.",
          "range": "uri",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpReadResourceRequestParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpReadResourceResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpReadResourceResult",
      "description": "The result returned by the server for a {@link ReadResourceRequestresources/read} request.",
      "in_subset": [
        "resources_read"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ReadResourceResult"
      ],
      "is_a": "McpCacheableResult",
      "slots": [
        "mcpReadResourceResult__meta",
        "mcpReadResourceResult__cache_scope",
        "mcpReadResourceResult__contents",
        "mcpReadResourceResult__result_type",
        "mcpReadResourceResult__ttl_ms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpResultMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "cache_scope",
          "description": "Indicates the intended scope of the cached response, analogous to HTTP\n`Cache-Control: public` vs `Cache-Control: private`.\n\n- `\"public\"`: The response does not contain user-specific data. Any\n  client or intermediary (e.g., shared gateway, caching proxy) MAY cache\n  the response and serve it across authorization contexts.\n- `\"private\"`: The response MAY be cached and reused only within the\n  same authorization context. Caches MUST NOT be shared across\n  authorization contexts (e.g., a different access token requires a\n  different cache).",
          "alias": "cacheScope",
          "range": "McpCacheScope",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "contents",
          "description": "The contents of the resource that was read.",
          "required": true,
          "multivalued": true,
          "inlined_as_list": true,
          "any_of": [
            {
              "range": "McpTextResourceContents",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpBlobResourceContents",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "result_type",
          "description": "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`.",
          "alias": "resultType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ttl_ms",
          "description": "A hint from the server indicating how long (in milliseconds) the\nclient MAY cache this response before re-fetching. Semantics are\nanalogous to HTTP Cache-Control max-age.\n\n- If 0, The response SHOULD be considered immediately stale,\n  The client MAY re-fetch every time the result is needed.\n- If positive, the client SHOULD consider the result fresh for this many\n  milliseconds after receiving the response.",
          "alias": "ttlMs",
          "range": "integer",
          "required": true,
          "minimum_value": 0,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpReadResourceResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpReadResourceResultResponse",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpReadResourceResultResponse",
      "description": "A successful response from the server for a {@link ReadResourceRequestresources/read} request.",
      "in_subset": [
        "resources_read"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ReadResourceResultResponse"
      ],
      "is_a": "McpJSONRPCResultResponse",
      "slots": [
        "mcpReadResourceResultResponse__identifier",
        "mcpReadResourceResultResponse__jsonrpc",
        "mcpReadResourceResultResponse__result"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "result",
          "description": "What the request returned.",
          "required": true,
          "any_of": [
            {
              "range": "McpInputRequiredResult",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpReadResourceResult",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpReadResourceResultResponse",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpRequest",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpRequest",
      "description": "MCP's `Request`.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:Request"
      ],
      "slots": [
        "mcpRequest__method",
        "mcpRequest__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "method",
          "description": "The name of the method.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "The parameters the message carries.",
          "range": "McpJSONObject",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpRequest",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpRequestMetaObject",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpRequestMetaObject",
      "description": "Extends {@link MetaObject} with additional request-specific fields. All key naming rules from `MetaObject` apply.",
      "in_subset": [
        "common_types"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:RequestMetaObject"
      ],
      "is_a": "McpMetaObject",
      "slots": [
        "mcpRequestMetaObject__mcp_client_capabilities",
        "mcpRequestMetaObject__mcp_client_info",
        "mcpRequestMetaObject__mcp_log_level",
        "mcpRequestMetaObject__mcp_protocol_version",
        "mcpRequestMetaObject__progress_token"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "mcp_client_capabilities",
          "description": "The client's capabilities for this specific request. Required.\n\nCapabilities are declared per-request rather than once at initialization;\nan empty object means the client supports no optional capabilities.\nServers MUST NOT infer capabilities from prior requests.",
          "aliases": [
            "io.modelcontextprotocol/clientCapabilities"
          ],
          "range": "McpClientCapabilities",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "mcp_client_info",
          "description": "Identifies the client software making the request. Clients SHOULD\ninclude this field on every request unless specifically configured not\nto do so.\n\nThe {@link Implementation} schema requires `name` and `version`; other\nfields are optional.\n\nThe value is self-reported by the client and is not verified by the\nprotocol. It is intended for display, logging, and debugging. Servers\nSHOULD NOT use it to change their behavior, and SHOULD NOT rely on it for\nsecurity decisions.",
          "aliases": [
            "io.modelcontextprotocol/clientInfo"
          ],
          "range": "McpImplementation",
          "@type": "SlotDefinition"
        },
        {
          "name": "mcp_log_level",
          "description": "The desired log level for this request. Optional.\n\nIf absent, the server MUST NOT send any {@link LoggingMessageNotificationnotifications/message}\nnotifications for this request. The client opts in to log messages by\nexplicitly setting a level. Replaces the former `logging/setLevel` RPC.",
          "aliases": [
            "io.modelcontextprotocol/logLevel"
          ],
          "range": "McpLoggingLevel",
          "@type": "SlotDefinition"
        },
        {
          "name": "mcp_protocol_version",
          "description": "The MCP Protocol Version being used for this request. Required.\n\nFor the HTTP transport, this value MUST match the `MCP-Protocol-Version`\nheader; otherwise the server MUST return a `400 Bad Request`. If the\nserver does not support the requested version, it MUST return an\n{@link UnsupportedProtocolVersionError}.",
          "aliases": [
            "io.modelcontextprotocol/protocolVersion"
          ],
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "progress_token",
          "description": "If specified, the caller is requesting out-of-band progress notifications for this request (as represented by {@link ProgressNotificationnotifications/progress}). The value of this parameter is an opaque token that will be attached to any subsequent notifications. The receiver is not obligated to provide these notifications.",
          "alias": "progressToken",
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpRequestMetaObject",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpRequestParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpRequestParams",
      "description": "Common params for any request.",
      "in_subset": [
        "common_types"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:RequestParams"
      ],
      "slots": [
        "mcpRequestParams__meta"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional request-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpRequestMetaObject",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpRequestParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpResource",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpResource",
      "description": "A known resource that the server is capable of reading.",
      "in_subset": [
        "resources_list"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:Resource"
      ],
      "is_a": "McpBaseMetadata",
      "mixins": [
        "McpIcons"
      ],
      "slots": [
        "McpResource_description",
        "McpResource_name",
        "McpResource_title",
        "mcpResource__meta",
        "mcpResource__annotations",
        "mcpResource__icons",
        "mcpResource__mime_type",
        "mcpResource__size",
        "mcpResource__uri"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "annotations",
          "description": "Optional annotations for the client.",
          "range": "McpAnnotations",
          "@type": "SlotDefinition"
        },
        {
          "name": "icons",
          "description": "Optional set of sized icons that the client can display in a user interface.\n\nClients that support rendering icons MUST support at least the following MIME types:\n- `image/png` - PNG images (safe, universal compatibility)\n- `image/jpeg` (and `image/jpg`) - JPEG images (safe, universal compatibility)\n\nClients that support rendering icons SHOULD also support:\n- `image/svg+xml` - SVG images (scalable but requires security precautions)\n- `image/webp` - WebP images (modern, efficient format)",
          "range": "McpIcon",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "mime_type",
          "description": "The MIME type of this resource, if known.",
          "alias": "mimeType",
          "@type": "SlotDefinition"
        },
        {
          "name": "size",
          "description": "The size of the raw resource content, in bytes (i.e., before base64 encoding or any tokenization), if known.\n\nThis can be used by Hosts to display file sizes and estimate context window usage.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "uri",
          "description": "The URI of this resource.",
          "range": "uri",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpResource",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpResourceContents",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpResourceContents",
      "description": "The contents of a specific resource or sub-resource.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ResourceContents"
      ],
      "slots": [
        "mcpResourceContents__meta",
        "mcpResourceContents__mime_type",
        "mcpResourceContents__uri"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "mime_type",
          "description": "The MIME type of this resource, if known.",
          "alias": "mimeType",
          "@type": "SlotDefinition"
        },
        {
          "name": "uri",
          "description": "The URI of this resource.",
          "range": "uri",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpResourceContents",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpResourceLink",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpResourceLink",
      "description": "A resource that the server is capable of reading, included in a prompt or tool call result.\n\nNote: resource links returned by tools are not guaranteed to appear in the results of {@link ListResourcesRequestresources/list} requests.",
      "in_subset": [
        "content"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ResourceLink"
      ],
      "is_a": "McpResource",
      "slots": [
        "McpResourceLink_description",
        "McpResourceLink_name",
        "McpResourceLink_title",
        "mcpResourceLink__meta",
        "mcpResourceLink__annotations",
        "mcpResourceLink__icons",
        "mcpResourceLink__mime_type",
        "mcpResourceLink__size",
        "mcpResourceLink__kind",
        "mcpResourceLink__uri"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "annotations",
          "description": "Optional annotations for the client.",
          "range": "McpAnnotations",
          "@type": "SlotDefinition"
        },
        {
          "name": "icons",
          "description": "Optional set of sized icons that the client can display in a user interface.\n\nClients that support rendering icons MUST support at least the following MIME types:\n- `image/png` - PNG images (safe, universal compatibility)\n- `image/jpeg` (and `image/jpg`) - JPEG images (safe, universal compatibility)\n\nClients that support rendering icons SHOULD also support:\n- `image/svg+xml` - SVG images (scalable but requires security precautions)\n- `image/webp` - WebP images (modern, efficient format)",
          "range": "McpIcon",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "mime_type",
          "description": "The MIME type of this resource, if known.",
          "alias": "mimeType",
          "@type": "SlotDefinition"
        },
        {
          "name": "size",
          "description": "The size of the raw resource content, in bytes (i.e., before base64 encoding or any tokenization), if known.\n\nThis can be used by Hosts to display file sizes and estimate context window usage.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "kind",
          "description": "The kind of object, always `resource_link`.",
          "aliases": [
            "type"
          ],
          "required": true,
          "equals_string": "resource_link",
          "@type": "SlotDefinition"
        },
        {
          "name": "uri",
          "description": "The URI of this resource.",
          "range": "uri",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpResourceLink",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpResourceListChangedNotification",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpResourceListChangedNotification",
      "description": "An optional notification from the server to the client, informing it that the list of resources it can read from has changed. This is only delivered on a {@link SubscriptionsListenRequestsubscriptions/listen} stream when the client requested it via the `resourcesListChanged` filter field.",
      "in_subset": [
        "notifications_resources_list_changed"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ResourceListChangedNotification"
      ],
      "is_a": "McpJSONRPCNotification",
      "slots": [
        "mcpResourceListChangedNotification__jsonrpc",
        "mcpResourceListChangedNotification__method",
        "mcpResourceListChangedNotification__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `notifications/resources/list_changed`.",
          "required": true,
          "equals_string": "notifications/resources/list_changed",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Common params for any notification.",
          "range": "McpNotificationParams",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpResourceListChangedNotification",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpResourceRequestParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpResourceRequestParams",
      "description": "Common params for resource-related requests.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
