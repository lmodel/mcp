          "name": "argument",
          "description": "The argument's information",
          "range": "McpCompleteRequestParamsArgument",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "context_info",
          "description": "Additional, optional context for completions",
          "aliases": [
            "context"
          ],
          "range": "McpCompleteRequestParamsContext",
          "@type": "SlotDefinition"
        },
        {
          "name": "ref",
          "description": "What the completion is for: a prompt or a resource template.",
          "required": true,
          "any_of": [
            {
              "range": "McpPromptReference",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpResourceTemplateReference",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCompleteRequestParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCompleteRequestParamsArgument",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCompleteRequestParamsArgument",
      "description": "The argument's information",
      "in_subset": [
        "completion_complete"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CompleteRequestParams/properties/argument"
      ],
      "slots": [
        "McpCompleteRequestParamsArgument_name",
        "mcpCompleteRequestParamsArgument__value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "value",
          "description": "The value of the argument to use for completion matching.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCompleteRequestParamsArgument",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCompleteRequestParamsContext",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCompleteRequestParamsContext",
      "description": "Additional, optional context for completions",
      "in_subset": [
        "completion_complete"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CompleteRequestParams/properties/context"
      ],
      "slots": [
        "mcpCompleteRequestParamsContext__arguments"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "arguments",
          "description": "Previously-resolved variables in a URI template or prompt.",
          "range": "McpCompleteRequestParamsContextArguments",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCompleteRequestParamsContext",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCompleteRequestParamsContextArguments",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCompleteRequestParamsContextArguments",
      "description": "Previously-resolved variables in a URI template or prompt.",
      "in_subset": [
        "completion_complete"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CompleteRequestParams/properties/context/properties/arguments"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpCompleteRequestParamsContextArguments",
      "extra_slots": {
        "range_expression": {
          "range": "string",
          "@type": "AnonymousSlotExpression"
        },
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCompleteResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCompleteResult",
      "description": "The result returned by the server for a {@link CompleteRequestcompletion/complete} request.",
      "in_subset": [
        "completion_complete"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CompleteResult"
      ],
      "is_a": "McpResult",
      "slots": [
        "mcpCompleteResult__meta",
        "mcpCompleteResult__completion",
        "mcpCompleteResult__result_type"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpResultMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "completion",
          "description": "The completion values and whether more are available.",
          "range": "McpCompleteResultCompletion",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "result_type",
          "description": "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`.",
          "alias": "resultType",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCompleteResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCompleteResultCompletion",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCompleteResultCompletion",
      "description": "The object MCP's `CompleteResult` holds under `completion`.",
      "in_subset": [
        "completion_complete"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CompleteResult/properties/completion"
      ],
      "slots": [
        "mcpCompleteResultCompletion__has_more",
        "mcpCompleteResultCompletion__total",
        "mcpCompleteResultCompletion__values"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "has_more",
          "description": "Indicates whether there are additional completion options beyond those provided in the current response, even if the exact total is unknown.",
          "alias": "hasMore",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "total",
          "description": "The total number of completion options available. This can exceed the number of values actually sent in the response.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "values",
          "description": "An array of completion values. Must not exceed 100 items.",
          "required": true,
          "multivalued": true,
          "maximum_cardinality": 100,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCompleteResultCompletion",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCompleteResultResponse",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCompleteResultResponse",
      "description": "A successful response from the server for a {@link CompleteRequestcompletion/complete} request.",
      "in_subset": [
        "completion_complete"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CompleteResultResponse"
      ],
      "is_a": "McpJSONRPCResultResponse",
      "slots": [
        "mcpCompleteResultResponse__identifier",
        "mcpCompleteResultResponse__jsonrpc",
        "mcpCompleteResultResponse__result"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "result",
          "description": "The result returned by the server for a {@link CompleteRequestcompletion/complete} request.",
          "range": "McpCompleteResult",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCompleteResultResponse",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpContentBlock",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpContentBlock",
      "description": "One of `TextContent`, `ImageContent`, `AudioContent`, `ResourceLink`, `EmbeddedResource`.",
      "in_subset": [
        "content"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ContentBlock"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpContentBlock",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "any_of": [
        {
          "is_a": "McpTextContent",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpImageContent",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpAudioContent",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpResourceLink",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpEmbeddedResource",
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCreateMessageRequest",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCreateMessageRequest",
      "description": "A request from the server to sample an LLM via the client. The client has full discretion over which model to select. The client should also inform the user before beginning sampling, to allow them to inspect the request (human in the loop) and decide whether to approve it.",
      "in_subset": [
        "sampling_createmessage"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CreateMessageRequest"
      ],
      "slots": [
        "mcpCreateMessageRequest__method",
        "mcpCreateMessageRequest__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "method",
          "description": "The method's name, always `sampling/createMessage`.",
          "required": true,
          "equals_string": "sampling/createMessage",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Parameters for a `sampling/createMessage` request.",
          "range": "McpCreateMessageRequestParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCreateMessageRequest",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCreateMessageRequestParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCreateMessageRequestParams",
      "description": "Parameters for a `sampling/createMessage` request.",
      "in_subset": [
        "sampling_createmessage"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CreateMessageRequestParams"
      ],
      "slots": [
        "mcpCreateMessageRequestParams__include_context",
        "mcpCreateMessageRequestParams__max_tokens",
        "mcpCreateMessageRequestParams__messages",
        "mcpCreateMessageRequestParams__metadata",
        "mcpCreateMessageRequestParams__model_preferences",
        "mcpCreateMessageRequestParams__stop_sequences",
        "mcpCreateMessageRequestParams__system_prompt",
        "mcpCreateMessageRequestParams__temperature",
        "mcpCreateMessageRequestParams__tool_choice",
        "mcpCreateMessageRequestParams__tools"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "include_context",
          "description": "A request to include context from one or more MCP servers (including the caller), to be attached to the prompt.\nThe client MAY ignore this request.\n\nDefault is `\"none\"`. The values `\"thisServer\"` and `\"allServers\"` are deprecated (SEP-2596): servers SHOULD\nomit this field or use `\"none\"`, and SHOULD only use the deprecated values if the client declares\n{@link ClientCapabilities.sampling.context}.",
          "alias": "includeContext",
          "range": "McpCreateMessageRequestParamsIncludeContext",
          "@type": "SlotDefinition"
        },
        {
          "name": "max_tokens",
          "description": "The requested maximum number of tokens to sample (to prevent runaway completions).\n\nThe client MAY choose to sample fewer tokens than the requested maximum.",
          "alias": "maxTokens",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "messages",
          "description": "Describes a message issued to or received from an LLM API.",
          "range": "McpSamplingMessage",
          "required": true,
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "metadata",
          "description": "Optional metadata to pass through to the LLM provider. The format of this metadata is provider-specific.",
          "range": "McpJSONObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "model_preferences",
          "description": "The server's preferences for which model to select. The client MAY ignore these preferences.",
          "alias": "modelPreferences",
          "range": "McpModelPreferences",
          "@type": "SlotDefinition"
        },
        {
          "name": "stop_sequences",
          "description": "Sequences at which the model should stop generating.",
          "alias": "stopSequences",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "system_prompt",
          "description": "An optional system prompt the server wants to use for sampling. The client MAY modify or omit this prompt.",
          "alias": "systemPrompt",
          "@type": "SlotDefinition"
        },
        {
          "name": "temperature",
          "description": "The sampling temperature the server asks the model to use.",
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "tool_choice",
          "description": "Controls how the model uses tools.\nThe client MUST return an error if this field is provided but {@link ClientCapabilities.sampling.tools} is not declared.\nDefault is `{ mode: \"auto\" }`.",
          "alias": "toolChoice",
          "range": "McpToolChoice",
          "@type": "SlotDefinition"
        },
        {
          "name": "tools",
          "description": "Tools that the model may use during generation.\nThe client MUST return an error if this field is provided but {@link ClientCapabilities.sampling.tools} is not declared.",
          "range": "McpTool",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCreateMessageRequestParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCreateMessageResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCreateMessageResult",
      "description": "The result returned by the client for a {@link CreateMessageRequestsampling/createMessage} request.\nThe client should inform the user before returning the sampled message, to allow them\nto inspect the response (human in the loop) and decide whether to allow the server to see it.",
      "in_subset": [
        "sampling_createmessage"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CreateMessageResult"
      ],
      "is_a": "McpSamplingMessage",
      "slots": [
        "mcpCreateMessageResult__meta",
        "mcpCreateMessageResult__content",
        "mcpCreateMessageResult__model",
        "mcpCreateMessageResult__role",
        "mcpCreateMessageResult__stop_reason"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "content",
          "description": "The content the message carries.",
          "required": true,
          "any_of": [
            {
              "range": "McpTextContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpImageContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpAudioContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpToolUseContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpToolResultContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpSamplingMessageContentBlock",
              "multivalued": true,
              "inlined_as_list": true,
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "model",
          "description": "The name of the model that generated the message.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "role",
          "description": "The sender or recipient of messages and data in a conversation.",
          "range": "McpRole",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "stop_reason",
          "description": "The reason why sampling stopped, if known.\n\nStandard values:\n- `\"endTurn\"`: Natural end of the assistant's turn\n- `\"stopSequence\"`: A stop sequence was encountered\n- `\"maxTokens\"`: Maximum token limit was reached\n- `\"toolUse\"`: The model wants to use one or more tools\n\nThis field is an open string to allow for provider-specific stop reasons.",
          "alias": "stopReason",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCreateMessageResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpDiscoverRequest",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpDiscoverRequest",
      "description": "A request from the client asking the server to advertise its supported\nprotocol versions, capabilities, and other metadata. Servers **MUST**\nimplement `server/discover`. Clients **MAY** call it but are not required\nto \u2014 version negotiation can also happen inline via per-request `_meta`.",
      "in_subset": [
        "server_discover"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:DiscoverRequest"
      ],
      "is_a": "McpJSONRPCRequest",
      "slots": [
        "mcpDiscoverRequest__identifier",
        "mcpDiscoverRequest__jsonrpc",
        "mcpDiscoverRequest__method",
        "mcpDiscoverRequest__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `server/discover`.",
          "required": true,
          "equals_string": "server/discover",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Common params for any request.",
          "range": "McpRequestParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpDiscoverRequest",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpDiscoverResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpDiscoverResult",
      "description": "The result returned by the server for a {@link DiscoverRequestserver/discover} request.",
      "in_subset": [
        "server_discover"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:DiscoverResult"
      ],
      "is_a": "McpCacheableResult",
      "slots": [
        "mcpDiscoverResult__meta",
        "mcpDiscoverResult__cache_scope",
        "mcpDiscoverResult__capabilities",
        "mcpDiscoverResult__instructions",
        "mcpDiscoverResult__result_type",
        "mcpDiscoverResult__supported_versions",
        "mcpDiscoverResult__ttl_ms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpResultMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "cache_scope",
          "description": "Indicates the intended scope of the cached response, analogous to HTTP\n`Cache-Control: public` vs `Cache-Control: private`.\n\n- `\"public\"`: The response does not contain user-specific data. Any\n  client or intermediary (e.g., shared gateway, caching proxy) MAY cache\n  the response and serve it across authorization contexts.\n- `\"private\"`: The response MAY be cached and reused only within the\n  same authorization context. Caches MUST NOT be shared across\n  authorization contexts (e.g., a different access token requires a\n  different cache).",
          "alias": "cacheScope",
          "range": "McpCacheScope",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "capabilities",
          "description": "The capabilities of the server.",
          "range": "McpServerCapabilities",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "instructions",
          "description": "Natural-language guidance describing the server and its features.\n\nThis can be used by clients to improve an LLM's understanding of\navailable tools (e.g., by including it in a system prompt). It should\nfocus on information that helps the model use the server effectively\nand should not duplicate information already in tool descriptions.",
          "@type": "SlotDefinition"
        },
        {
          "name": "result_type",
          "description": "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`.",
          "alias": "resultType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "supported_versions",
          "description": "MCP Protocol Versions this server supports. The client should choose a\nversion from this list for use in subsequent requests.",
          "alias": "supportedVersions",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ttl_ms",
          "description": "A hint from the server indicating how long (in milliseconds) the\nclient MAY cache this response before re-fetching. Semantics are\nanalogous to HTTP Cache-Control max-age.\n\n- If 0, The response SHOULD be considered immediately stale,\n  The client MAY re-fetch every time the result is needed.\n- If positive, the client SHOULD consider the result fresh for this many\n  milliseconds after receiving the response.",
          "alias": "ttlMs",
          "range": "integer",
          "required": true,
          "minimum_value": 0,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpDiscoverResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
