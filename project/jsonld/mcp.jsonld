    },
    {
      "name": "McpServerResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpServerResult",
      "description": "One of `Result`, `InputRequiredResult`, `DiscoverResult`, `ListResourcesResult`, `ListResourceTemplatesResult`, `ReadResourceResult`, `SubscriptionsListenResult`, `ListPromptsResult`, `GetPromptResult`, `ListToolsResult`, `CallToolResult`, `CompleteResult`.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ServerResult"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpServerResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "any_of": [
        {
          "is_a": "McpResult",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpInputRequiredResult",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpDiscoverResult",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpListResourcesResult",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpListResourceTemplatesResult",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpReadResourceResult",
