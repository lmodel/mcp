            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "result",
          "description": "The result returned by the server for a {@link ListPromptsRequestprompts/list} request.",
          "range": "McpListPromptsResult",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpListPromptsResultResponse",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpListResourceTemplatesRequest",
