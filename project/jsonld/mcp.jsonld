        "mcpGetPromptResultResponse__jsonrpc",
        "mcpGetPromptResultResponse__result"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "result",
          "description": "What the request returned.",
          "required": true,
          "any_of": [
            {
              "range": "McpInputRequiredResult",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpGetPromptResult",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpGetPromptResultResponse",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpHeaderMismatchError",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpHeaderMismatchError",
      "description": "Returned when a server rejects a request because the values in the HTTP\nheaders do not match the corresponding values in the request body, or\nbecause required headers are missing or malformed. For HTTP, the response\nstatus code MUST be `400 Bad Request`.",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:HeaderMismatchError"
      ],
      "is_a": "McpJSONRPCErrorResponse",
      "slots": [
        "mcpHeaderMismatchError__error",
        "mcpHeaderMismatchError__identifier",
        "mcpHeaderMismatchError__jsonrpc"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "error",
          "description": "The error the request ended with.",
          "range": "McpHeaderMismatchErrorError",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "identifier",
          "description": "A uniquely identifying ID for a request in JSON-RPC.",
          "aliases": [
            "id"
          ],
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpHeaderMismatchError",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpHeaderMismatchErrorError",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpHeaderMismatchErrorError",
      "description": "MCP's `Error`, with the code and data this error carries.",
      "in_subset": [
        "errors"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:HeaderMismatchError/properties/error/allOf/1"
      ],
      "is_a": "McpError",
      "slots": [
        "mcpError__data",
        "mcpError__message",
        "mcpHeaderMismatchErrorError__code"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "code",
          "description": "The error code, always `-32020`.",
          "range": "integer",
          "required": true,
          "equals_number": -32020,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpHeaderMismatchErrorError",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpIcon",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpIcon",
      "description": "An optionally-sized icon that can be displayed in a user interface.",
      "in_subset": [
        "common_types"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:Icon"
      ],
      "slots": [
        "mcpIcon__mime_type",
        "mcpIcon__sizes",
        "mcpIcon__src",
        "mcpIcon__theme"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "mime_type",
          "description": "Optional MIME type override if the source MIME type is missing or generic.\nFor example: `\"image/png\"`, `\"image/jpeg\"`, or `\"image/svg+xml\"`.",
          "alias": "mimeType",
          "@type": "SlotDefinition"
        },
        {
          "name": "sizes",
          "description": "Optional array of strings that specify sizes at which the icon can be used.\nEach string should be in WxH format (e.g., `\"48x48\"`, `\"96x96\"`) or `\"any\"` for scalable formats like SVG.\n\nIf not provided, the client should assume that the icon can be used at any size.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "src",
          "description": "A standard URI pointing to an icon resource. May be an HTTP/HTTPS URL or a\n`data:` URI with Base64-encoded image data.\n\nConsumers SHOULD take steps to ensure URLs serving icons are from the\nsame domain as the client/server or a trusted domain.\n\nConsumers SHOULD take appropriate precautions when consuming SVGs as they can contain\nexecutable JavaScript.",
          "range": "uri",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "theme",
          "description": "Optional specifier for the theme this icon is designed for. `\"light\"` indicates\nthe icon is designed to be used with a light background, and `\"dark\"` indicates\nthe icon is designed to be used with a dark background.\n\nIf not provided, the client should assume the icon can be used with any theme.",
          "range": "McpIconTheme",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpIcon",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpIcons",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpIcons",
      "description": "Base interface to add `icons` property.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:Icons"
      ],
      "slots": [
        "mcpIcons__icons"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "icons",
          "description": "Optional set of sized icons that the client can display in a user interface.\n\nClients that support rendering icons MUST support at least the following MIME types:\n- `image/png` - PNG images (safe, universal compatibility)\n- `image/jpeg` (and `image/jpg`) - JPEG images (safe, universal compatibility)\n\nClients that support rendering icons SHOULD also support:\n- `image/svg+xml` - SVG images (scalable but requires security precautions)\n- `image/webp` - WebP images (modern, efficient format)",
          "range": "McpIcon",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpIcons",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpImageContent",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpImageContent",
      "description": "An image provided to or from an LLM.",
      "in_subset": [
        "content"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ImageContent"
      ],
      "slots": [
        "mcpImageContent__meta",
        "mcpImageContent__annotations",
        "mcpImageContent__data",
        "mcpImageContent__mime_type",
        "mcpImageContent__kind"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "annotations",
          "description": "Optional annotations for the client.",
          "range": "McpAnnotations",
          "@type": "SlotDefinition"
        },
        {
          "name": "data",
          "description": "The base64-encoded image data.",
          "range": "McpBase64",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "mime_type",
          "description": "The MIME type of the image. Different providers may support different image types.",
          "alias": "mimeType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "kind",
          "description": "The kind of object, always `image`.",
          "aliases": [
            "type"
          ],
          "required": true,
          "equals_string": "image",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpImageContent",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpImplementation",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpImplementation",
      "description": "Describes the MCP implementation.",
      "in_subset": [
        "server_discover"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:Implementation"
      ],
      "is_a": "McpBaseMetadata",
      "mixins": [
        "McpIcons"
      ],
      "slots": [
        "McpImplementation_description",
        "McpImplementation_name",
        "McpImplementation_title",
        "McpImplementation_version",
        "mcpImplementation__icons",
        "mcpImplementation__website_url"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "icons",
          "description": "Optional set of sized icons that the client can display in a user interface.\n\nClients that support rendering icons MUST support at least the following MIME types:\n- `image/png` - PNG images (safe, universal compatibility)\n- `image/jpeg` (and `image/jpg`) - JPEG images (safe, universal compatibility)\n\nClients that support rendering icons SHOULD also support:\n- `image/svg+xml` - SVG images (scalable but requires security precautions)\n- `image/webp` - WebP images (modern, efficient format)",
          "range": "McpIcon",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "website_url",
          "description": "An optional URL of the website for this implementation.",
          "alias": "websiteUrl",
          "range": "uri",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpImplementation",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpInputRequest",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpInputRequest",
      "description": "One of `CreateMessageRequest`, `ListRootsRequest`, `ElicitRequest`.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:InputRequest"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpInputRequest",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "any_of": [
        {
          "is_a": "McpCreateMessageRequest",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpListRootsRequest",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpElicitRequest",
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "McpInputRequests",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpInputRequests",
      "description": "A map of server-initiated requests that the client must fulfill.\nKeys are server-assigned identifiers; values are the request objects.",
      "in_subset": [
        "multi_round_trip"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:InputRequests"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpInputRequests",
      "extra_slots": {
        "range_expression": {
          "range": "McpInputRequest",
          "@type": "AnonymousSlotExpression"
        },
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpInputRequiredResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpInputRequiredResult",
      "description": "An InputRequiredResult sent by the server to indicate that additional input is needed\nbefore the request can be completed.\n\nAt least one of `inputRequests` or `requestState` MUST be present.",
      "comments": [
        "MCP's description states this rule, which its schema.json does not: At least one of `inputRequests` or `requestState` MUST be present."
      ],
      "in_subset": [
        "multi_round_trip"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:InputRequiredResult"
      ],
      "is_a": "McpResult",
      "slots": [
        "mcpInputRequiredResult__meta",
        "mcpInputRequiredResult__input_requests",
        "mcpInputRequiredResult__request_state",
        "mcpInputRequiredResult__result_type"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpResultMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "input_requests",
          "description": "A map of server-initiated requests that the client must fulfill.\nKeys are server-assigned identifiers; values are the request objects.",
          "alias": "inputRequests",
          "range": "McpInputRequests",
          "@type": "SlotDefinition"
        },
        {
          "name": "request_state",
          "description": "State for the client to send back unchanged when it retries the request.",
          "alias": "requestState",
          "@type": "SlotDefinition"
        },
        {
          "name": "result_type",
          "description": "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`.",
          "alias": "resultType",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpInputRequiredResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "any_of": [
        {
          "slot_conditions": [
            {
              "name": "input_requests",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "request_state",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "McpInputResponse",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpInputResponse",
      "description": "One of `CreateMessageResult`, `ListRootsResult`, `ElicitResult`.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:InputResponse"
      ],
      "slot_usage": {},
