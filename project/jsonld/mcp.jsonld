      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCancelledNotification",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCancelledNotification",
      "description": "This notification is sent by the client to indicate that it is cancelling a request it previously issued.\n\nOn stdio, the server also sends this notification, solely to terminate a {@link SubscriptionsListenRequestsubscriptions/listen} stream: it references the ID of the `subscriptions/listen` request that opened the stream. Servers MUST NOT use this notification to cancel any other request.\n\nThe request SHOULD still be in-flight, but due to communication latency, it is always possible that this notification MAY arrive after the request has already finished.\n\nThis notification indicates that the result will be unused, so any associated processing SHOULD cease.",
      "in_subset": [
        "notifications_cancelled"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CancelledNotification"
      ],
      "is_a": "McpJSONRPCNotification",
      "slots": [
        "mcpCancelledNotification__jsonrpc",
        "mcpCancelledNotification__method",
        "mcpCancelledNotification__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `notifications/cancelled`.",
          "required": true,
          "equals_string": "notifications/cancelled",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Parameters for a `notifications/cancelled` notification.",
          "range": "McpCancelledNotificationParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCancelledNotification",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpCancelledNotificationParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpCancelledNotificationParams",
      "description": "Parameters for a `notifications/cancelled` notification.",
      "in_subset": [
        "notifications_cancelled"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:CancelledNotificationParams"
      ],
      "is_a": "McpNotificationParams",
      "slots": [
        "mcpCancelledNotificationParams__meta",
        "mcpCancelledNotificationParams__reason_text",
        "mcpCancelledNotificationParams__request_id"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional notification-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpNotificationMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "reason_text",
          "description": "An optional string describing the reason for the cancellation. This MAY be logged or presented to the user.",
          "aliases": [
            "reason"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "request_id",
          "description": "The ID of the request to cancel.\n\nThis MUST correspond to the ID of a request the client previously issued.",
          "alias": "requestId",
          "required": true,
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "integer",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpCancelledNotificationParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
