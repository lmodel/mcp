      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpResourceUpdatedNotification",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpResourceUpdatedNotification",
      "description": "A notification from the server to the client, informing it that a resource has changed and may need to be read again. This is only sent for resources the client opted in to via the `resourceSubscriptions` field of a {@link SubscriptionsListenRequestsubscriptions/listen} request.",
      "in_subset": [
        "notifications_resources_updated"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ResourceUpdatedNotification"
      ],
      "is_a": "McpJSONRPCNotification",
      "slots": [
        "mcpResourceUpdatedNotification__jsonrpc",
        "mcpResourceUpdatedNotification__method",
        "mcpResourceUpdatedNotification__params"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "jsonrpc",
          "description": "The JSON-RPC version, always `2.0`.",
          "required": true,
          "equals_string": "2.0",
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The method's name, always `notifications/resources/updated`.",
          "required": true,
          "equals_string": "notifications/resources/updated",
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "Parameters for a `notifications/resources/updated` notification.",
          "range": "McpResourceUpdatedNotificationParams",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpResourceUpdatedNotification",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpResourceUpdatedNotificationParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpResourceUpdatedNotificationParams",
      "description": "Parameters for a `notifications/resources/updated` notification.",
      "in_subset": [
        "notifications_resources_updated"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ResourceUpdatedNotificationParams"
      ],
      "is_a": "McpNotificationParams",
      "slots": [
        "mcpResourceUpdatedNotificationParams__meta",
        "mcpResourceUpdatedNotificationParams__uri"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional notification-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpNotificationMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "uri",
          "description": "The URI of the resource that has been updated. This might be a sub-resource of the one that the client actually subscribed to.",
          "range": "uri",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpResourceUpdatedNotificationParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpResult",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpResult",
      "description": "Common result fields.",
      "in_subset": [
        "common_types"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:Result"
      ],
      "slots": [
        "mcpResult__meta",
        "mcpResult__result_type"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpResultMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "result_type",
          "description": "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`.",
          "alias": "resultType",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpResult",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpResultMetaObject",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpResultMetaObject",
      "description": "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply.",
      "in_subset": [
        "common_types"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ResultMetaObject"
      ],
      "is_a": "McpMetaObject",
      "slots": [
        "mcpResultMetaObject__mcp_server_info"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "mcp_server_info",
          "description": "Identifies the server software producing the response. Servers SHOULD\ninclude this field on every response unless specifically configured not\nto do so.\n\nThe {@link Implementation} schema requires `name` and `version`; other\nfields are optional.\n\nThe value is self-reported by the server and is not verified by the\nprotocol. It is intended for display, logging, and debugging. Clients\nSHOULD NOT use it to change their behavior, and SHOULD NOT rely on it for\nsecurity decisions.",
          "aliases": [
            "io.modelcontextprotocol/serverInfo"
          ],
          "range": "McpImplementation",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpResultMetaObject",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpRoot",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpRoot",
      "description": "Represents a root directory or file that the server can operate on.",
      "in_subset": [
        "roots_list"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:Root"
      ],
      "slots": [
        "McpRoot_name",
        "mcpRoot__meta",
        "mcpRoot__uri"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "uri",
          "description": "The URI identifying the root. This *must* start with `file://` for now.\nThis restriction may be relaxed in future versions of the protocol to allow\nother URI schemes.",
          "range": "uri",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpRoot",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpSamplingMessage",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSamplingMessage",
      "description": "Describes a message issued to or received from an LLM API.",
      "in_subset": [
        "sampling_createmessage"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SamplingMessage"
      ],
      "slots": [
        "mcpSamplingMessage__meta",
        "mcpSamplingMessage__content",
        "mcpSamplingMessage__role"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional \u2014 if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`).",
          "alias": "_meta",
          "range": "McpMetaObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "content",
          "description": "The content the message carries.",
          "required": true,
          "any_of": [
            {
              "range": "McpTextContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpImageContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpAudioContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpToolUseContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpToolResultContent",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "McpSamplingMessageContentBlock",
              "multivalued": true,
              "inlined_as_list": true,
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "role",
          "description": "The sender or recipient of messages and data in a conversation.",
          "range": "McpRole",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpSamplingMessage",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpSamplingMessageContentBlock",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpSamplingMessageContentBlock",
      "description": "One of `TextContent`, `ImageContent`, `AudioContent`, `ToolUseContent`, `ToolResultContent`.",
      "in_subset": [
        "sampling_createmessage"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:SamplingMessageContentBlock"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpSamplingMessageContentBlock",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "any_of": [
        {
          "is_a": "McpTextContent",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpImageContent",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpAudioContent",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpToolUseContent",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpToolResultContent",
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "McpServerCapabilities",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpServerCapabilities",
      "description": "Capabilities that a server may support. Known capabilities are defined here, in this schema, but this is not a closed set: any server can define its own, additional capabilities.",
      "in_subset": [
        "server_discover"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ServerCapabilities"
      ],
      "slots": [
        "mcpServerCapabilities__completions",
        "mcpServerCapabilities__experimental",
        "mcpServerCapabilities__extensions",
        "mcpServerCapabilities__logging",
        "mcpServerCapabilities__prompts",
        "mcpServerCapabilities__resources",
        "mcpServerCapabilities__tools"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "completions",
          "description": "Present if the server supports argument autocompletion suggestions.",
          "range": "McpJSONObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "experimental",
          "description": "Experimental, non-standard capabilities that the server supports.",
          "range": "McpServerCapabilitiesExperimental",
          "@type": "SlotDefinition"
        },
        {
          "name": "extensions",
          "description": "Optional MCP extensions that the server supports. Keys are extension identifiers\n(e.g., \"io.modelcontextprotocol/tasks\"), and values are per-extension settings\nobjects. An empty object indicates support with no settings.\n\nKeys MUST follow the {@link MetaObject`_meta` key naming rules}, with a\nmandatory prefix.",
          "range": "McpServerCapabilitiesExtensions",
          "@type": "SlotDefinition"
        },
        {
          "name": "logging",
          "description": "Present if the server supports sending log messages to the client.",
          "range": "McpJSONObject",
          "@type": "SlotDefinition"
        },
        {
          "name": "prompts",
          "description": "Present if the server offers any prompt templates.",
          "range": "McpServerCapabilitiesPrompts",
          "@type": "SlotDefinition"
        },
        {
          "name": "resources",
          "description": "Present if the server offers any resources to read.",
          "range": "McpServerCapabilitiesResources",
          "@type": "SlotDefinition"
        },
        {
          "name": "tools",
          "description": "Present if the server offers any tools to call.",
          "range": "McpServerCapabilitiesTools",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpServerCapabilities",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpServerCapabilitiesExperimental",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpServerCapabilitiesExperimental",
      "description": "Experimental, non-standard capabilities that the server supports.",
      "in_subset": [
        "server_discover"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:ServerCapabilities/properties/experimental"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpServerCapabilitiesExperimental",
      "extra_slots": {
        "range_expression": {
          "range": "McpJSONObject",
          "@type": "AnonymousSlotExpression"
        },
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpServerCapabilitiesExtensions",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpServerCapabilitiesExtensions",
      "description": "Optional MCP extensions that the server supports. Keys are extension identifiers\n(e.g., \"io.modelcontextprotocol/tasks\"), and values are per-extension settings\nobjects. An empty object indicates support with no settings.\n\nKeys MUST follow the {@link MetaObject`_meta` key naming rules}, with a\nmandatory prefix.",
      "in_subset": [
        "server_discover"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
