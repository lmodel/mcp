      "prefix_reference": "https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/"
    }
  ],
  "default_prefix": "mcp",
  "default_range": "string",
