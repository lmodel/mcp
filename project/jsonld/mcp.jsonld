        },
        {
          "is_a": "McpListRootsResult",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "McpElicitResult",
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "McpInputResponseRequestParams",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpInputResponseRequestParams",
      "description": "MCP's `InputResponseRequestParams`.",
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:InputResponseRequestParams"
      ],
      "is_a": "McpRequestParams",
      "slots": [
        "mcpInputResponseRequestParams__meta",
        "mcpInputResponseRequestParams__input_responses",
        "mcpInputResponseRequestParams__request_state"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "meta",
          "description": "Extends {@link MetaObject} with additional request-specific fields. All key naming rules from `MetaObject` apply.",
          "alias": "_meta",
          "range": "McpRequestMetaObject",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "input_responses",
          "description": "A map of client responses to server-initiated requests.\nKeys correspond to the keys in the {@link InputRequests} map;\nvalues are the client's result for each request.",
          "alias": "inputResponses",
          "range": "McpInputResponses",
          "@type": "SlotDefinition"
        },
        {
          "name": "request_state",
          "description": "State the server returned with an input-required result, sent back unchanged when the request is retried.",
          "alias": "requestState",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/mcp/McpInputResponseRequestParams",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "McpInputResponses",
      "definition_uri": "https://w3id.org/lmodel/mcp/McpInputResponses",
      "description": "A map of client responses to server-initiated requests.\nKeys correspond to the keys in the {@link InputRequests} map;\nvalues are the client's result for each request.",
      "in_subset": [
        "multi_round_trip"
      ],
      "from_schema": "https://w3id.org/lmodel/mcp",
      "exact_mappings": [
        "mcp_schema:InputResponses"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/mcp/McpInputResponses",
      "extra_slots": {
