	rdfs:label "McpSubscriptionsListenRequestParams" ;
	rdfs:subClassOf mcp:McpRequestParams , _:c14n1227 , _:c14n1383 , _:c14n1464 , _:c14n36 , _:c14n751 , _:c14n779 ;
	skos:definition "Parameters for a {@link SubscriptionsListenRequestsubscriptions/listen} request." ;
