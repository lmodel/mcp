	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpClientCapabilitiesExtensions a owl:Class ;
	rdfs:label "McpClientCapabilitiesExtensions" ;
	skos:definition "Optional MCP extensions that the client supports. Keys are extension identifiers\n(e.g., \"io.modelcontextprotocol/oauth-client-credentials\"), and values are\nper-extension settings objects. An empty object indicates support with no settings.\n\nKeys MUST follow the {@link MetaObject`_meta` key naming rules}, with a\nmandatory prefix." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ClientCapabilities/properties/extensions> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpClientCapabilitiesRoots a owl:Class ;
	rdfs:label "McpClientCapabilitiesRoots" ;
	skos:definition "Present if the client supports listing roots." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ClientCapabilities/properties/roots> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpClientCapabilitiesSampling a owl:Class ;
	rdfs:label "McpClientCapabilitiesSampling" ;
	rdfs:subClassOf _:c14n1229 , _:c14n1500 , _:c14n224 , _:c14n590 , _:c14n662 , _:c14n763 ;
	skos:definition "Present if the client supports sampling from an LLM." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ClientCapabilities/properties/sampling> ;
