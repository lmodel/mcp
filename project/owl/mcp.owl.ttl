	rdfs:subClassOf mcp:McpResultMetaObject , _:c14n1169 , _:c14n1557 , _:c14n179 , _:c14n456 , _:c14n713 , _:c14n987 ;
	skos:definition "Extends {@link ResultMetaObject} with the subscription-stream identifier carried by a\n{@link SubscriptionsListenResult}. All key naming rules from `MetaObject` apply." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/SubscriptionsListenResultMetaObject> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
