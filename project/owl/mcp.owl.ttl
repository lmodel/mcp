	rdfs:subClassOf _:c14n1055 , _:c14n1277 , _:c14n1363 , _:c14n203 , _:c14n499 , _:c14n769 ;
	skos:definition "Present if the client supports elicitation from the server." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ClientCapabilities/properties/elicitation> ;
