	rdfs:subClassOf mcp:McpJSONRPCResultResponse , _:c14n1132 , _:c14n1252 , _:c14n1589 , _:c14n1603 , _:c14n264 , _:c14n605 , _:c14n617 , _:c14n677 , _:c14n903 ;
	skos:definition "A successful response from the server for a {@link SubscriptionsListenRequestsubscriptions/listen}\nrequest, sent when the server tears the subscription down gracefully." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/SubscriptionsListenResultResponse> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
