xsd:base64Binary a rdfs:Datatype ;
	owl:equivalentClass xsd:string .
<https://w3id.org/lmodel/mcp.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/modelcontextprotocol/modelcontextprotocol/tree/2026-07-28/schema/2026-07-28> ;
	dcterms:title "Model Context Protocol (MCP) 2026-07-28" ;
	pav:version "2026-07-28" ;
	a owl:Ontology ;
	rdfs:label "mcp" ;
	rdfs:seeAlso <https://lmodel.github.io/mcp> , <https://modelcontextprotocol.io/specification/2026-07-28> ;
	skos:definition "The messages and objects of the Model Context Protocol, version 2026-07-28, as its schema.json states them: JSON-RPC requests, results, notifications and errors, and the tools, resources, prompts, content and capabilities they carry. Generated from MCP's own files by scripts/mcp_to_linkml.py." .
