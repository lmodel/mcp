	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpTool a owl:Class ;
	rdfs:label "McpTool" ;
	rdfs:subClassOf mcp:McpBaseMetadata , mcp:McpIcons , _:c14n1023 , _:c14n1101 , _:c14n1253 , _:c14n1279 , _:c14n1332 , _:c14n1420 , _:c14n1437 , _:c14n159 , _:c14n248 , _:c14n253 , _:c14n296 , _:c14n303 , _:c14n320 , _:c14n371 , _:c14n504 , _:c14n581 , _:c14n616 , _:c14n62 , _:c14n669 , _:c14n694 , _:c14n805 , _:c14n823 , _:c14n85 ;
	skos:definition "Definition for a tool the client can call." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/Tool> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpToolAnnotations a owl:Class ;
	rdfs:label "McpToolAnnotations" ;
	rdfs:subClassOf _:c14n1027 , _:c14n1053 , _:c14n1122 , _:c14n1314 , _:c14n1530 , _:c14n1541 , _:c14n202 , _:c14n3 , _:c14n421 , _:c14n5 , _:c14n525 , _:c14n636 , _:c14n762 , _:c14n801 , _:c14n973 ;
	skos:definition "Additional properties describing a {@link Tool} to clients.\n\nNOTE: all properties in `ToolAnnotations` are **hints**.\nThey are not guaranteed to provide a faithful description of\ntool behavior (including descriptive properties like `title`).\n\nClients should never make tool use decisions based on `ToolAnnotations`\nreceived from untrusted servers." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ToolAnnotations> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpToolChoice a owl:Class ;
	rdfs:label "McpToolChoice" ;
	rdfs:subClassOf _:c14n1281 , _:c14n469 , _:c14n881 ;
	skos:definition "Controls tool selection behavior for sampling requests." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ToolChoice> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpToolChoiceMode\#auto a owl:Class ;
	rdfs:label "auto" ;
	rdfs:subClassOf mcp:McpToolChoiceMode .
mcp:McpToolChoiceMode\#none a owl:Class ;
	rdfs:label "none" ;
	rdfs:subClassOf mcp:McpToolChoiceMode .
mcp:McpToolChoiceMode\#required a owl:Class ;
	rdfs:label "required" ;
	rdfs:subClassOf mcp:McpToolChoiceMode .
mcp:McpToolChoiceMode a owl:Class ;
	rdfs:label "McpToolChoiceMode" ;
	owl:unionOf _:c14n972 ;
	skos:definition "The values MCP allows for `mode`." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ToolChoice/properties/mode> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	linkml:permissible_values mcp:McpToolChoiceMode\#auto , mcp:McpToolChoiceMode\#none , mcp:McpToolChoiceMode\#required .
mcp:McpToolInputSchema a owl:Class ;
	rdfs:label "McpToolInputSchema" ;
	rdfs:subClassOf _:c14n1005 , _:c14n1104 , _:c14n354 , _:c14n459 , _:c14n695 , _:c14n854 ;
	skos:definition "A JSON Schema object defining the expected parameters for the tool.\n\nTool arguments are always JSON objects, so `type: \"object\"` is required at the root.\nBeyond that, any JSON Schema 2020-12 keyword may appear alongside `type` — including\ncomposition keywords (`oneOf`, `anyOf`, `allOf`, `not`), conditional keywords\n(`if`/`then`/`else`), reference keywords (`$ref`, `$defs`, `$anchor`), and any other\nstandard validation or annotation keywords.\n\nProperty schemas may carry an `x-mcp-header` annotation to mirror the\nargument value into an HTTP header on the Streamable HTTP transport. See\nthe Streamable HTTP transport specification for the validity and\nextraction rules.\n\nDefaults to JSON Schema 2020-12 when no explicit `$schema` is provided." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/Tool/properties/inputSchema> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpToolListChangedNotification a owl:Class ;
	rdfs:label "McpToolListChangedNotification" ;
	rdfs:subClassOf mcp:McpJSONRPCNotification , _:c14n256 , _:c14n377 , _:c14n420 , _:c14n435 , _:c14n490 , _:c14n82 , _:c14n869 , _:c14n889 , _:c14n980 ;
	skos:definition "An optional notification from the server to the client, informing it that the list of tools it offers has changed. This is only delivered on a {@link SubscriptionsListenRequestsubscriptions/listen} stream when the client requested it via the `toolsListChanged` filter field." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ToolListChangedNotification> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpToolOutputSchema a owl:Class ;
	rdfs:label "McpToolOutputSchema" ;
	rdfs:subClassOf _:c14n1370 , _:c14n180 , _:c14n96 ;
	skos:definition "An optional JSON Schema object defining the structure of the tool's output returned in\nthe structuredContent field of a {@link CallToolResult}. This can be any valid JSON Schema 2020-12.\n\nDefaults to JSON Schema 2020-12 when no explicit `$schema` is provided." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/Tool/properties/outputSchema> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpToolResultContent a owl:Class ;
	rdfs:label "McpToolResultContent" ;
	rdfs:subClassOf _:c14n1014 , _:c14n1026 , _:c14n1083 , _:c14n1117 , _:c14n1201 , _:c14n1259 , _:c14n1414 , _:c14n193 , _:c14n345 , _:c14n350 , _:c14n418 , _:c14n50 , _:c14n627 , _:c14n748 , _:c14n882 , _:c14n897 , _:c14n969 ;
	skos:definition "The result of a tool use, provided by the user back to the assistant." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ToolResultContent> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpToolUseContent a owl:Class ;
	rdfs:label "McpToolUseContent" ;
	rdfs:subClassOf _:c14n1126 , _:c14n1144 , _:c14n1192 , _:c14n126 , _:c14n127 , _:c14n1361 , _:c14n1416 , _:c14n1467 , _:c14n1473 , _:c14n1588 , _:c14n173 , _:c14n592 , _:c14n647 , _:c14n731 , _:c14n812 ;
	skos:definition "A request from the assistant to call a tool." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/ToolUseContent> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpUnsupportedProtocolVersionError a owl:Class ;
	rdfs:label "McpUnsupportedProtocolVersionError" ;
	rdfs:subClassOf mcp:McpJSONRPCErrorResponse , _:c14n1296 , _:c14n1394 , _:c14n149 , _:c14n1490 , _:c14n157 , _:c14n634 , _:c14n658 , _:c14n905 , _:c14n938 ;
	skos:definition "Returned when the request's protocol version is unknown to the server or\nunsupported (e.g., a known experimental or draft version the server has\nchosen not to implement). For HTTP, the response status code MUST be\n`400 Bad Request`." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/UnsupportedProtocolVersionError> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpUnsupportedProtocolVersionErrorError a owl:Class ;
	rdfs:label "McpUnsupportedProtocolVersionErrorError" ;
	rdfs:subClassOf mcp:McpError , _:c14n1130 , _:c14n1232 , _:c14n1450 , _:c14n162 , _:c14n445 , _:c14n730 ;
	skos:definition "MCP's `Error`, with the code and data this error carries." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/UnsupportedProtocolVersionError/properties/error/allOf/1> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpUnsupportedProtocolVersionErrorErrorData a owl:Class ;
	rdfs:label "McpUnsupportedProtocolVersionErrorErrorData" ;
	rdfs:subClassOf _:c14n1151 , _:c14n1185 , _:c14n1241 , _:c14n250 , _:c14n997 ;
	skos:definition "The object MCP's `UnsupportedProtocolVersionError` holds under `data`." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/UnsupportedProtocolVersionError/properties/error/allOf/1/properties/data> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpUntitledMultiSelectEnumSchema a owl:Class ;
	rdfs:label "McpUntitledMultiSelectEnumSchema" ;
	rdfs:subClassOf _:c14n1119 , _:c14n1266 , _:c14n1275 , _:c14n1290 , _:c14n1297 , _:c14n1308 , _:c14n1364 , _:c14n138 , _:c14n1419 , _:c14n1550 , _:c14n223 , _:c14n249 , _:c14n352 , _:c14n513 , _:c14n582 , _:c14n744 , _:c14n777 , _:c14n86 , _:c14n918 , _:c14n955 ;
	skos:definition "Schema for multiple-selection enumeration without display titles for options." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/UntitledMultiSelectEnumSchema> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpUntitledMultiSelectEnumSchemaItems a owl:Class ;
	rdfs:label "McpUntitledMultiSelectEnumSchemaItems" ;
	rdfs:subClassOf _:c14n1271 , _:c14n1329 , _:c14n1367 , _:c14n446 , _:c14n604 ;
	skos:definition "Schema for the array items." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/UntitledMultiSelectEnumSchema/properties/items> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpUntitledSingleSelectEnumSchema a owl:Class ;
	rdfs:label "McpUntitledSingleSelectEnumSchema" ;
	rdfs:subClassOf _:c14n1155 , _:c14n133 , _:c14n1348 , _:c14n1350 , _:c14n1451 , _:c14n359 , _:c14n488 , _:c14n536 , _:c14n564 , _:c14n567 , _:c14n660 , _:c14n843 , _:c14n900 , _:c14n98 ;
	skos:definition "Schema for single-selection enumeration without display titles for options." ;
	skos:exactMatch <https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/2026-07-28/schema/2026-07-28/schema.json#/$defs/UntitledSingleSelectEnumSchema> ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:McpUriTemplate a rdfs:Datatype ;
	owl:equivalentClass _:c14n496 .
mcp:action a owl:ObjectProperty ;
	rdfs:label "action" ;
	skos:definition "The user action in response to the elicitation.\n- `\"accept\"`: User submitted the form/confirmed the action\n- `\"decline\"`: User explicitly declined the action\n- `\"cancel\"`: User dismissed without making an explicit choice" ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:annotations a owl:ObjectProperty .
mcp:any_of a owl:ObjectProperty ;
	rdfs:label "any_of" ;
	skos:definition "Array of enum options with values and display labels." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "anyOf" .
mcp:argument a owl:ObjectProperty ;
	rdfs:label "argument" ;
	skos:definition "The argument's information" ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:arguments a owl:ObjectProperty .
mcp:audience a owl:DatatypeProperty ;
	rdfs:label "audience" ;
	skos:definition "Who an object or its data is for." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:blob a owl:DatatypeProperty ;
	rdfs:label "blob" ;
	skos:definition "A base64-encoded string representing the binary data of the item." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:cache_scope a owl:ObjectProperty .
mcp:capabilities a owl:ObjectProperty ;
	rdfs:label "capabilities" ;
	skos:definition "The capabilities of the server." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:code a owl:DatatypeProperty .
mcp:completion a owl:ObjectProperty ;
	rdfs:label "completion" ;
	skos:definition "The completion values and whether more are available." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:completions a owl:ObjectProperty ;
	rdfs:label "completions" ;
	skos:definition "Present if the server supports argument autocompletion suggestions." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:const a owl:DatatypeProperty .
mcp:content a owl:DatatypeProperty , owl:ObjectProperty .
mcp:contents a owl:DatatypeProperty ;
	rdfs:label "contents" ;
	skos:definition "The contents of the resource that was read." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:context a owl:DatatypeProperty ;
	rdfs:label "context" ;
	skos:definition "Context: for a completion, the arguments resolved so far; for sampling, support for including it." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:cost_priority a owl:DatatypeProperty ;
	rdfs:label "cost_priority" ;
	skos:definition "How much to prioritize cost when selecting a model. A value of 0 means cost\nis not important, while a value of 1 means cost is the most important\nfactor." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "costPriority" .
mcp:cursor a owl:DatatypeProperty ;
	rdfs:label "cursor" ;
	skos:definition "An opaque token representing the current pagination position.\nIf provided, the server should return results starting after this cursor." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:data a owl:DatatypeProperty , owl:ObjectProperty .
mcp:default a owl:DatatypeProperty .
mcp:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "A description for people to read." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:destructive_hint a owl:DatatypeProperty ;
	rdfs:label "destructive_hint" ;
	skos:definition "If true, the tool may perform destructive updates to its environment.\nIf false, the tool performs only additive updates.\n\n(This property is meaningful only when `readOnlyHint == false`)\n\nDefault: true" ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "destructiveHint" .
mcp:elicitation a owl:ObjectProperty ;
	rdfs:label "elicitation" ;
	skos:definition "Present if the client supports elicitation from the server." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:enum a owl:DatatypeProperty .
mcp:enum_names a owl:DatatypeProperty ;
	rdfs:label "enum_names" ;
	skos:definition "(Legacy) Display names for enum values.\nNon-standard according to JSON schema 2020-12." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "enumNames" .
mcp:error a owl:ObjectProperty .
mcp:experimental a owl:ObjectProperty .
mcp:extensions a owl:ObjectProperty .
mcp:form a owl:ObjectProperty ;
	rdfs:label "form" ;
	skos:definition "Settings for elicitation by form." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:format a owl:ObjectProperty ;
	rdfs:label "format" ;
	skos:definition "The format the string must have." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:has_more a owl:DatatypeProperty ;
	rdfs:label "has_more" ;
	skos:definition "Indicates whether there are additional completion options beyond those provided in the current response, even if the exact total is unknown." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "hasMore" .
mcp:hints a owl:ObjectProperty ;
	rdfs:label "hints" ;
	skos:definition "Optional hints to use for model selection.\n\nIf multiple hints are specified, the client MUST evaluate them in order\n(such that the first match is taken).\n\nThe client SHOULD prioritize these hints over the numeric priorities, but\nMAY still use the priorities to select from ambiguous matches." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:icons a owl:ObjectProperty .
mcp:id a owl:DatatypeProperty ;
	rdfs:label "id" ;
	skos:definition "An identifier: of a JSON-RPC request, or of a tool use." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:idempotent_hint a owl:DatatypeProperty ;
	rdfs:label "idempotent_hint" ;
	skos:definition "If true, calling the tool repeatedly with the same arguments\nwill have no additional effect on its environment.\n\n(This property is meaningful only when `readOnlyHint == false`)\n\nDefault: false" ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "idempotentHint" .
mcp:include_context a owl:ObjectProperty ;
	rdfs:label "include_context" ;
	skos:definition "A request to include context from one or more MCP servers (including the caller), to be attached to the prompt.\nThe client MAY ignore this request.\n\nDefault is `\"none\"`. The values `\"thisServer\"` and `\"allServers\"` are deprecated (SEP-2596): servers SHOULD\nomit this field or use `\"none\"`, and SHOULD only use the deprecated values if the client declares\n{@link ClientCapabilities.sampling.context}." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "includeContext" .
mcp:input a owl:ObjectProperty ;
	rdfs:label "input" ;
	skos:definition "The arguments to pass to the tool, conforming to the tool's input schema." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:input_requests a owl:ObjectProperty ;
	rdfs:label "input_requests" ;
	skos:definition "A map of server-initiated requests that the client must fulfill.\nKeys are server-assigned identifiers; values are the request objects." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "inputRequests" .
mcp:input_responses a owl:ObjectProperty .
mcp:input_schema a owl:ObjectProperty ;
	rdfs:label "input_schema" ;
	skos:definition "A JSON Schema object defining the expected parameters for the tool.\n\nTool arguments are always JSON objects, so `type: \"object\"` is required at the root.\nBeyond that, any JSON Schema 2020-12 keyword may appear alongside `type` — including\ncomposition keywords (`oneOf`, `anyOf`, `allOf`, `not`), conditional keywords\n(`if`/`then`/`else`), reference keywords (`$ref`, `$defs`, `$anchor`), and any other\nstandard validation or annotation keywords.\n\nProperty schemas may carry an `x-mcp-header` annotation to mirror the\nargument value into an HTTP header on the Streamable HTTP transport. See\nthe Streamable HTTP transport specification for the validity and\nextraction rules.\n\nDefaults to JSON Schema 2020-12 when no explicit `$schema` is provided." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "inputSchema" .
mcp:instructions a owl:DatatypeProperty ;
	rdfs:label "instructions" ;
	skos:definition "Natural-language guidance describing the server and its features.\n\nThis can be used by clients to improve an LLM's understanding of\navailable tools (e.g., by including it in a system prompt). It should\nfocus on information that helps the model use the server effectively\nand should not duplicate information already in tool descriptions." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:intelligence_priority a owl:DatatypeProperty ;
	rdfs:label "intelligence_priority" ;
	skos:definition "How much to prioritize intelligence and capabilities when selecting a\nmodel. A value of 0 means intelligence is not important, while a value of 1\nmeans intelligence is the most important factor." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "intelligencePriority" .
mcp:is_error a owl:DatatypeProperty .
mcp:items a owl:ObjectProperty .
mcp:jsonrpc a owl:DatatypeProperty .
mcp:last_modified a owl:DatatypeProperty ;
	rdfs:label "last_modified" ;
	skos:definition "The moment the resource was last modified, as an ISO 8601 formatted string.\n\nShould be an ISO 8601 formatted string (e.g., \"2025-01-12T15:00:58Z\").\n\nExamples: last activity timestamp in an open file, timestamp when the resource\nwas attached, etc." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "lastModified" .
mcp:level a owl:ObjectProperty ;
	rdfs:label "level" ;
	skos:definition "The severity of this log message." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:list_changed a owl:DatatypeProperty .
mcp:logger a owl:DatatypeProperty ;
	rdfs:label "logger" ;
	skos:definition "An optional name of the logger issuing this message." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:logging a owl:ObjectProperty ;
	rdfs:label "logging" ;
	skos:definition "Present if the server supports sending log messages to the client." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:max_items a owl:DatatypeProperty .
mcp:max_length a owl:DatatypeProperty ;
	rdfs:label "max_length" ;
	skos:definition "The most characters the field accepts." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "maxLength" .
mcp:max_tokens a owl:DatatypeProperty ;
	rdfs:label "max_tokens" ;
	skos:definition "The requested maximum number of tokens to sample (to prevent runaway completions).\n\nThe client MAY choose to sample fewer tokens than the requested maximum." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "maxTokens" .
mcp:maximum a owl:DatatypeProperty ;
	rdfs:label "maximum" ;
	skos:definition "The largest value the field accepts." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:mcp_client_capabilities a owl:ObjectProperty ;
	rdfs:label "mcp_client_capabilities" ;
	skos:altLabel "io.modelcontextprotocol/clientCapabilities" ;
	skos:definition "The client's capabilities for this specific request. Required.\n\nCapabilities are declared per-request rather than once at initialization;\nan empty object means the client supports no optional capabilities.\nServers MUST NOT infer capabilities from prior requests." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:mcp_client_info a owl:ObjectProperty ;
	rdfs:label "mcp_client_info" ;
	skos:altLabel "io.modelcontextprotocol/clientInfo" ;
	skos:definition "Identifies the client software making the request. Clients SHOULD\ninclude this field on every request unless specifically configured not\nto do so.\n\nThe {@link Implementation} schema requires `name` and `version`; other\nfields are optional.\n\nThe value is self-reported by the client and is not verified by the\nprotocol. It is intended for display, logging, and debugging. Servers\nSHOULD NOT use it to change their behavior, and SHOULD NOT rely on it for\nsecurity decisions." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:mcp_log_level a owl:ObjectProperty ;
	rdfs:label "mcp_log_level" ;
	skos:altLabel "io.modelcontextprotocol/logLevel" ;
	skos:definition "The desired log level for this request. Optional.\n\nIf absent, the server MUST NOT send any {@link LoggingMessageNotificationnotifications/message}\nnotifications for this request. The client opts in to log messages by\nexplicitly setting a level. Replaces the former `logging/setLevel` RPC." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:mcp_protocol_version a owl:DatatypeProperty ;
	rdfs:label "mcp_protocol_version" ;
	skos:altLabel "io.modelcontextprotocol/protocolVersion" ;
	skos:definition "The MCP Protocol Version being used for this request. Required.\n\nFor the HTTP transport, this value MUST match the `MCP-Protocol-Version`\nheader; otherwise the server MUST return a `400 Bad Request`. If the\nserver does not support the requested version, it MUST return an\n{@link UnsupportedProtocolVersionError}." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:mcp_server_info a owl:ObjectProperty .
mcp:mcp_subscription_id a owl:DatatypeProperty .
mcp:message a owl:DatatypeProperty .
mcp:messages a owl:ObjectProperty .
mcp:meta a owl:ObjectProperty .
mcp:metadata a owl:ObjectProperty ;
	rdfs:label "metadata" ;
	skos:definition "Optional metadata to pass through to the LLM provider. The format of this metadata is provider-specific." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:method a owl:DatatypeProperty .
mcp:mime_type a owl:DatatypeProperty .
mcp:min_items a owl:DatatypeProperty .
mcp:min_length a owl:DatatypeProperty ;
	rdfs:label "min_length" ;
	skos:definition "The fewest characters the field accepts." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "minLength" .
mcp:minimum a owl:DatatypeProperty ;
	rdfs:label "minimum" ;
	skos:definition "The smallest value the field accepts." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:mode a owl:DatatypeProperty , owl:ObjectProperty .
mcp:model a owl:DatatypeProperty ;
	rdfs:label "model" ;
	skos:definition "The name of the model that generated the message." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:model_preferences a owl:ObjectProperty ;
	rdfs:label "model_preferences" ;
	skos:definition "The server's preferences for which model to select. The client MAY ignore these preferences." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "modelPreferences" .
mcp:name a owl:DatatypeProperty ;
	rdfs:label "name" ;
	skos:definition "The name a program uses to refer to the thing." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:next_cursor a owl:DatatypeProperty .
mcp:notifications a owl:ObjectProperty .
mcp:one_of a owl:ObjectProperty ;
	rdfs:label "one_of" ;
	skos:definition "Array of enum options with values and display labels." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "oneOf" .
mcp:open_world_hint a owl:DatatypeProperty ;
	rdfs:label "open_world_hint" ;
	skos:definition "If true, this tool may interact with an \"open world\" of external\nentities. If false, the tool's domain of interaction is closed.\nFor example, the world of a web search tool is open, whereas that\nof a memory tool is not.\n\nDefault: true" ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "openWorldHint" .
mcp:output_schema a owl:ObjectProperty ;
	rdfs:label "output_schema" ;
	skos:definition "An optional JSON Schema object defining the structure of the tool's output returned in\nthe structuredContent field of a {@link CallToolResult}. This can be any valid JSON Schema 2020-12.\n\nDefaults to JSON Schema 2020-12 when no explicit `$schema` is provided." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "outputSchema" .
mcp:params a owl:ObjectProperty .
mcp:priority a owl:DatatypeProperty ;
	rdfs:label "priority" ;
	skos:definition "Describes how important this data is for operating the server.\n\nA value of 1 means \"most important,\" and indicates that the data is\neffectively required, while 0 means \"least important,\" and indicates that\nthe data is entirely optional." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:progress a owl:DatatypeProperty ;
	rdfs:label "progress" ;
	skos:definition "The progress thus far. This should increase every time progress is made, even if the total is unknown." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:progress_token a owl:DatatypeProperty .
mcp:prompts a owl:ObjectProperty .
mcp:prompts_list_changed a owl:DatatypeProperty ;
	rdfs:label "prompts_list_changed" ;
	skos:definition "If true, receive {@link PromptListChangedNotificationnotifications/prompts/list_changed}." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "promptsListChanged" .
mcp:properties a owl:ObjectProperty ;
	rdfs:label "properties" ;
	skos:definition "The fields of the form, by name." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:read_only_hint a owl:DatatypeProperty ;
	rdfs:label "read_only_hint" ;
	skos:definition "If true, the tool does not modify its environment.\n\nDefault: false" ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "readOnlyHint" .
mcp:reason a owl:DatatypeProperty ;
	rdfs:label "reason" ;
	skos:definition "Why something happened, such as a request's cancellation, for people to read." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:ref a owl:DatatypeProperty ;
	rdfs:label "ref" ;
	skos:definition "What the completion is for: a prompt or a resource template." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:request_id a owl:DatatypeProperty ;
	rdfs:label "request_id" ;
	skos:definition "The ID of the request to cancel.\n\nThis MUST correspond to the ID of a request the client previously issued." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "requestId" .
mcp:request_state a owl:DatatypeProperty .
mcp:requested a owl:DatatypeProperty ;
	rdfs:label "requested" ;
	skos:definition "The protocol version that was requested by the client." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:requested_schema a owl:ObjectProperty ;
	rdfs:label "requested_schema" ;
	skos:definition "A restricted subset of JSON Schema.\nOnly top-level properties are allowed, without nesting." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "requestedSchema" .
mcp:required a owl:DatatypeProperty ;
	rdfs:label "required" ;
	skos:definition "Whether this argument must be provided." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:required_capabilities a owl:ObjectProperty ;
	rdfs:label "required_capabilities" ;
	skos:definition "The capabilities the server requires from the client to process this request." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "requiredCapabilities" .
mcp:required_names a owl:DatatypeProperty ;
	rdfs:label "required_names" ;
	skos:altLabel "required" ;
	skos:definition "The names of the fields the user must fill in." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:resource a owl:DatatypeProperty ;
	rdfs:label "resource" ;
	skos:definition "The contents of a resource embedded in a message." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:resource_subscriptions a owl:DatatypeProperty ;
	rdfs:label "resource_subscriptions" ;
	skos:definition "Subscribe to {@link ResourceUpdatedNotificationnotifications/resources/updated} for these resource URIs.\nReplaces the former `resources/subscribe` RPC." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "resourceSubscriptions" .
mcp:resource_templates a owl:ObjectProperty ;
	rdfs:label "resource_templates" ;
	skos:definition "A template description for resources available on the server." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "resourceTemplates" .
mcp:resources a owl:ObjectProperty .
mcp:resources_list_changed a owl:DatatypeProperty ;
	rdfs:label "resources_list_changed" ;
	skos:definition "If true, receive {@link ResourceListChangedNotificationnotifications/resources/list_changed}." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "resourcesListChanged" .
mcp:result a owl:DatatypeProperty , owl:ObjectProperty .
mcp:result_type a owl:DatatypeProperty .
mcp:role a owl:ObjectProperty .
mcp:roots a owl:ObjectProperty .
mcp:sampling a owl:ObjectProperty ;
	rdfs:label "sampling" ;
	skos:definition "Present if the client supports sampling from an LLM." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:schema_dialect a owl:DatatypeProperty .
mcp:size a owl:DatatypeProperty .
mcp:sizes a owl:DatatypeProperty ;
	rdfs:label "sizes" ;
	skos:definition "Optional array of strings that specify sizes at which the icon can be used.\nEach string should be in WxH format (e.g., `\"48x48\"`, `\"96x96\"`) or `\"any\"` for scalable formats like SVG.\n\nIf not provided, the client should assume that the icon can be used at any size." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:speed_priority a owl:DatatypeProperty ;
	rdfs:label "speed_priority" ;
	skos:definition "How much to prioritize sampling speed (latency) when selecting a model. A\nvalue of 0 means speed is not important, while a value of 1 means speed is\nthe most important factor." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "speedPriority" .
mcp:src a owl:DatatypeProperty ;
	rdfs:label "src" ;
	skos:definition "A standard URI pointing to an icon resource. May be an HTTP/HTTPS URL or a\n`data:` URI with Base64-encoded image data.\n\nConsumers SHOULD take steps to ensure URLs serving icons are from the\nsame domain as the client/server or a trusted domain.\n\nConsumers SHOULD take appropriate precautions when consuming SVGs as they can contain\nexecutable JavaScript." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:stop_reason a owl:DatatypeProperty ;
	rdfs:label "stop_reason" ;
	skos:definition "The reason why sampling stopped, if known.\n\nStandard values:\n- `\"endTurn\"`: Natural end of the assistant's turn\n- `\"stopSequence\"`: A stop sequence was encountered\n- `\"maxTokens\"`: Maximum token limit was reached\n- `\"toolUse\"`: The model wants to use one or more tools\n\nThis field is an open string to allow for provider-specific stop reasons." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "stopReason" .
mcp:stop_sequences a owl:DatatypeProperty ;
	rdfs:label "stop_sequences" ;
	skos:definition "Sequences at which the model should stop generating." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "stopSequences" .
mcp:structured_content a owl:ObjectProperty .
mcp:subscribe a owl:DatatypeProperty ;
	rdfs:label "subscribe" ;
	skos:definition "Whether this server supports subscribing to resource updates." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:supported a owl:DatatypeProperty ;
	rdfs:label "supported" ;
	skos:definition "Protocol versions the server supports. The client should choose a\nmutually supported version from this list and retry." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:supported_versions a owl:DatatypeProperty ;
	rdfs:label "supported_versions" ;
	skos:definition "MCP Protocol Versions this server supports. The client should choose a\nversion from this list for use in subsequent requests." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "supportedVersions" .
mcp:system_prompt a owl:DatatypeProperty ;
	rdfs:label "system_prompt" ;
	skos:definition "An optional system prompt the server wants to use for sampling. The client MAY modify or omit this prompt." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "systemPrompt" .
mcp:temperature a owl:DatatypeProperty ;
	rdfs:label "temperature" ;
	skos:definition "The sampling temperature the server asks the model to use." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:text a owl:DatatypeProperty .
mcp:theme a owl:ObjectProperty ;
	rdfs:label "theme" ;
	skos:definition "Optional specifier for the theme this icon is designed for. `\"light\"` indicates\nthe icon is designed to be used with a light background, and `\"dark\"` indicates\nthe icon is designed to be used with a dark background.\n\nIf not provided, the client should assume the icon can be used with any theme." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "A name for people to read." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:tool_choice a owl:ObjectProperty ;
	rdfs:label "tool_choice" ;
	skos:definition "Controls how the model uses tools.\nThe client MUST return an error if this field is provided but {@link ClientCapabilities.sampling.tools} is not declared.\nDefault is `{ mode: \"auto\" }`." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "toolChoice" .
mcp:tool_use_id a owl:DatatypeProperty ;
	rdfs:label "tool_use_id" ;
	skos:definition "The ID of the tool use this result corresponds to.\n\nThis MUST match the ID from a previous {@link ToolUseContent}." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "toolUseId" .
mcp:tools a owl:ObjectProperty .
mcp:tools_list_changed a owl:DatatypeProperty ;
	rdfs:label "tools_list_changed" ;
	skos:definition "If true, receive {@link ToolListChangedNotificationnotifications/tools/list_changed}." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "toolsListChanged" .
mcp:total a owl:DatatypeProperty .
mcp:ttl_ms a owl:DatatypeProperty .
mcp:type a owl:DatatypeProperty ;
	rdfs:label "type" ;
	skos:definition "The kind of an object or a value, as a constant or a value from a list." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:uri a owl:DatatypeProperty .
mcp:uri_template a owl:DatatypeProperty ;
	rdfs:label "uri_template" ;
	skos:definition "A URI template (according to RFC 6570) that can be used to construct resource URIs." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "uriTemplate" .
mcp:url a owl:DatatypeProperty ;
	rdfs:label "url" ;
	rdfs:range xsd:anyURI ;
	skos:definition "A URL." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:url_settings a owl:ObjectProperty ;
	rdfs:label "url_settings" ;
	skos:altLabel "url" ;
	skos:definition "Settings for elicitation by URL." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:value a owl:DatatypeProperty ;
	rdfs:label "value" ;
	skos:definition "The value of the argument to use for completion matching." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:values a owl:DatatypeProperty ;
	rdfs:label "values" ;
	skos:definition "An array of completion values. Must not exceed 100 items." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:version a owl:DatatypeProperty ;
	rdfs:label "version" ;
	skos:definition "A version string." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> .
mcp:website_url a owl:DatatypeProperty ;
	rdfs:label "website_url" ;
	skos:definition "An optional URL of the website for this implementation." ;
	skos:inScheme <https://w3id.org/lmodel/mcp> ;
	skos:prefLabel "websiteUrl" .
