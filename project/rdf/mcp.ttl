<https://w3id.org/lmodel/mcp/mcpUntitledMultiSelectEnumSchema__max_items> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "maxItems" ;
	linkml:description "Maximum number of items to select." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpUntitledMultiSelectEnumSchema> ;
