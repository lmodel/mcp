	skos:mappingRelation "https://w3id.org/lmodel/mcp/type"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/type"^^xsd:anyURI ;
	linkml:description "The kind of an object or a value, as a constant or a value from a list." ;
