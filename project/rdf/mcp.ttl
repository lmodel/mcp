	linkml:owner <https://w3id.org/lmodel/mcp/McpError> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/message"^^xsd:anyURI .
