	linkml:slot_uri "https://w3id.org/lmodel/mcp/_meta"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpRoot__uri> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "uri" ;
	linkml:description "The URI identifying the root. This *must* start with `file://` for now.\nThis restriction may be relaxed in future versions of the protocol to allow\nother URI schemes." ;
