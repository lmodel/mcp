<https://w3id.org/lmodel/mcp/mcpDiscoverResult__cache_scope> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "cacheScope" ;
	linkml:description "Indicates the intended scope of the cached response, analogous to HTTP\n`Cache-Control: public` vs `Cache-Control: private`.\n\n- `\"public\"`: The response does not contain user-specific data. Any\n  client or intermediary (e.g., shared gateway, caching proxy) MAY cache\n  the response and serve it across authorization contexts.\n- `\"private\"`: The response MAY be cached and reused only within the\n  same authorization context. Caches MUST NOT be shared across\n  authorization contexts (e.g., a different access token requires a\n  different cache)." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpDiscoverResult> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpDiscoverResult> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpCacheScope> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/cacheScope"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpDiscoverResult__capabilities> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "capabilities" ;
	linkml:description "The capabilities of the server." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpDiscoverResult> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpDiscoverResult> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpServerCapabilities> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/capabilities"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpDiscoverResult__instructions> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "instructions" ;
	linkml:description "Natural-language guidance describing the server and its features.\n\nThis can be used by clients to improve an LLM's understanding of\navailable tools (e.g., by including it in a system prompt). It should\nfocus on information that helps the model use the server effectively\nand should not duplicate information already in tool descriptions." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpDiscoverResult> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpDiscoverResult> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/instructions"^^xsd:anyURI .
