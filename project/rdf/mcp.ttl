	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpImplementation> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpIcon> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/icons"^^xsd:anyURI .
