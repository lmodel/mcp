<https://w3id.org/lmodel/mcp/mcpSubscriptionsListenResultMetaObject__mcp_subscription_id> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/subscriptionId" ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "mcp_subscription_id" ;
	linkml:any_of _:c14n385 , _:c14n46 ;
	linkml:description "Identifies the subscription stream this response closes, so the client can\ncorrelate it with the originating subscription — mirroring the same key on\nthe stream's notifications. The value is the JSON-RPC ID of the\n`subscriptions/listen` request that opened the stream (and equals this\nresponse's `id`)." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpSubscriptionsListenResultMetaObject> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpSubscriptionsListenResultMetaObject> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/mcp_subscription_id"^^xsd:anyURI .
