	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/jsonrpc"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpUntitledMultiSelectEnumSchemaItems__enum> a linkml:SlotDefinition ;
