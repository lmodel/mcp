	linkml:slot_uri "https://w3id.org/lmodel/mcp/error"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpUnsupportedProtocolVersionError__jsonrpc> a linkml:SlotDefinition ;
