<https://w3id.org/lmodel/mcp/objectidentifier> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "Used for inheritance and type checking" ;
	linkml:base "ElementIdentifier" ;
	linkml:definition_uri "https://w3id.org/linkml/Objectidentifier"^^xsd:anyURI ;
	linkml:description "A URI or CURIE that represents an object in the model." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/ns/shex#iri"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/one_of> a linkml:SlotDefinition ;
	skos:prefLabel "oneOf" ;
	linkml:description "Array of enum options with values and display labels." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/mcp/McpTitledSingleSelectEnumSchemaOneOf> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/open_world_hint> a linkml:SlotDefinition ;
	skos:prefLabel "openWorldHint" ;
	linkml:description "If true, this tool may interact with an \"open world\" of external\nentities. If false, the tool's domain of interaction is closed.\nFor example, the world of a web search tool is open, whereas that\nof a memory tool is not.\n\nDefault: true" ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> .
<https://w3id.org/lmodel/mcp/output_schema> a linkml:SlotDefinition ;
	skos:prefLabel "outputSchema" ;
	linkml:description "An optional JSON Schema object defining the structure of the tool's output returned in\nthe structuredContent field of a {@link CallToolResult}. This can be any valid JSON Schema 2020-12.\n\nDefaults to JSON Schema 2020-12 when no explicit `$schema` is provided." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpToolOutputSchema> .
<https://w3id.org/lmodel/mcp/params> a linkml:SlotDefinition ;
	linkml:description "Common params for any notification." , "Common params for any request." , "Common params for paginated requests." , "Parameters for a `completion/complete` request." , "Parameters for a `notifications/cancelled` notification." , "Parameters for a `notifications/message` notification." , "Parameters for a `notifications/resources/updated` notification." , "Parameters for a `prompts/get` request." , "Parameters for a `resources/read` request." , "Parameters for a `sampling/createMessage` request." , "Parameters for a `tools/call` request." , "Parameters for a {@link ProgressNotificationnotifications/progress} notification." , "Parameters for a {@link SubscriptionsAcknowledgedNotificationnotifications/subscriptions/acknowledged} notification." , "Parameters for a {@link SubscriptionsListenRequestsubscriptions/listen} request." , "The parameters for a request to elicit additional information from the user via the client." , "The parameters the message carries." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpCallToolRequestParams> , <https://w3id.org/lmodel/mcp/McpCancelledNotificationParams> , <https://w3id.org/lmodel/mcp/McpCompleteRequestParams> , <https://w3id.org/lmodel/mcp/McpCreateMessageRequestParams> , <https://w3id.org/lmodel/mcp/McpElicitRequestParams> , <https://w3id.org/lmodel/mcp/McpGetPromptRequestParams> , <https://w3id.org/lmodel/mcp/McpJSONObject> , <https://w3id.org/lmodel/mcp/McpListRootsRequestParams> , <https://w3id.org/lmodel/mcp/McpLoggingMessageNotificationParams> , <https://w3id.org/lmodel/mcp/McpNotificationParams> , <https://w3id.org/lmodel/mcp/McpPaginatedRequestParams> , <https://w3id.org/lmodel/mcp/McpProgressNotificationParams> , <https://w3id.org/lmodel/mcp/McpReadResourceRequestParams> , <https://w3id.org/lmodel/mcp/McpRequestParams> , <https://w3id.org/lmodel/mcp/McpResourceUpdatedNotificationParams> , <https://w3id.org/lmodel/mcp/McpSubscriptionsAcknowledgedNotificationParams> , <https://w3id.org/lmodel/mcp/McpSubscriptionsListenRequestParams> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/priority> a linkml:SlotDefinition ;
	linkml:description "Describes how important this data is for operating the server.\n\nA value of 1 means \"most important,\" and indicates that the data is\neffectively required, while 0 means \"least important,\" and indicates that\nthe data is entirely optional." ;
	linkml:maximum_value "1"^^linkml:\@id ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/mcp/float> .
<https://w3id.org/lmodel/mcp/progress> a linkml:SlotDefinition ;
	linkml:description "The progress thus far. This should increase every time progress is made, even if the total is unknown." ;
	linkml:range <https://w3id.org/lmodel/mcp/float> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/progress_token> a linkml:SlotDefinition ;
	skos:prefLabel "progressToken" ;
	linkml:any_of _:c14n547 , _:c14n548 , _:c14n553 , _:c14n554 ;
	linkml:description "If specified, the caller is requesting out-of-band progress notifications for this request (as represented by {@link ProgressNotificationnotifications/progress}). The value of this parameter is an opaque token that will be attached to any subsequent notifications. The receiver is not obligated to provide these notifications." , "The progress token which was given in the initial request, used to associate this notification with the request that is proceeding." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/prompts> a linkml:SlotDefinition ;
	linkml:description "A prompt or prompt template that the server offers." , "Present if the server offers any prompt templates." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/mcp/McpPrompt> , <https://w3id.org/lmodel/mcp/McpServerCapabilitiesPrompts> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/prompts_get> dcterms:title "prompts/get" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/PromptsGet"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category prompts/get`." .
<https://w3id.org/lmodel/mcp/prompts_list> dcterms:title "prompts/list" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/PromptsList"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category prompts/list`." .
<https://w3id.org/lmodel/mcp/prompts_list_changed> a linkml:SlotDefinition ;
	skos:prefLabel "promptsListChanged" ;
	linkml:description "If true, receive {@link PromptListChangedNotificationnotifications/prompts/list_changed}." ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> .
<https://w3id.org/lmodel/mcp/properties> a linkml:SlotDefinition ;
	linkml:description "The fields of the form, by name." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpElicitRequestFormParamsRequestedSchemaProperties> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/read_only_hint> a linkml:SlotDefinition ;
	skos:prefLabel "readOnlyHint" ;
	linkml:description "If true, the tool does not modify its environment.\n\nDefault: false" ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> .
<https://w3id.org/lmodel/mcp/reason> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/mcp/reason"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/reason"^^xsd:anyURI ;
	linkml:description "Why something happened, such as a request's cancellation, for people to read." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpCancelledNotificationParams> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpCancelledNotificationParams> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/reason"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/ref> a linkml:SlotDefinition ;
	linkml:any_of _:c14n255 , _:c14n453 ;
	linkml:description "What the completion is for: a prompt or a resource template." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/request_id> a linkml:SlotDefinition ;
	skos:prefLabel "requestId" ;
	linkml:any_of _:c14n27 , _:c14n87 ;
	linkml:description "The ID of the request to cancel.\n\nThis MUST correspond to the ID of a request the client previously issued." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/request_state> a linkml:SlotDefinition ;
	skos:prefLabel "requestState" ;
	linkml:description "State for the client to send back unchanged when it retries the request." , "State the server returned with an input-required result, sent back unchanged when the request is retried." ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/mcp/requested> a linkml:SlotDefinition ;
	linkml:description "The protocol version that was requested by the client." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/requested_schema> a linkml:SlotDefinition ;
	skos:prefLabel "requestedSchema" ;
	linkml:description "A restricted subset of JSON Schema.\nOnly top-level properties are allowed, without nesting." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpElicitRequestFormParamsRequestedSchema> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/required> a linkml:SlotDefinition ;
	linkml:description "Whether this argument must be provided." ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> ;
	linkml:slot_uri "schema:valueRequired"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/required_capabilities> a linkml:SlotDefinition ;
	skos:prefLabel "requiredCapabilities" ;
	linkml:description "The capabilities the server requires from the client to process this request." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpClientCapabilities> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/required_names> a linkml:SlotDefinition ;
	skos:altLabel "required" ;
	linkml:description "The names of the fields the user must fill in." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/mcp/resource> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/mcp/resource"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/resource"^^xsd:anyURI ;
	linkml:description "The contents of a resource embedded in a message." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpEmbeddedResource> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpEmbeddedResource> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/resource"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/resource_subscriptions> a linkml:SlotDefinition ;
	skos:prefLabel "resourceSubscriptions" ;
	linkml:description "Subscribe to {@link ResourceUpdatedNotificationnotifications/resources/updated} for these resource URIs.\nReplaces the former `resources/subscribe` RPC." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/mcp/resource_templates> a linkml:SlotDefinition ;
	skos:prefLabel "resourceTemplates" ;
	linkml:description "A template description for resources available on the server." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/mcp/McpResourceTemplate> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/resources> a linkml:SlotDefinition ;
	linkml:description "A known resource that the server is capable of reading." , "Present if the server offers any resources to read." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/mcp/McpResource> , <https://w3id.org/lmodel/mcp/McpServerCapabilitiesResources> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/resources_list> dcterms:title "resources/list" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/ResourcesList"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category resources/list`." .
<https://w3id.org/lmodel/mcp/resources_list_changed> a linkml:SlotDefinition ;
	skos:prefLabel "resourcesListChanged" ;
	linkml:description "If true, receive {@link ResourceListChangedNotificationnotifications/resources/list_changed}." ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> .
<https://w3id.org/lmodel/mcp/resources_read> dcterms:title "resources/read" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/ResourcesRead"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category resources/read`." .
<https://w3id.org/lmodel/mcp/resources_templates_list> dcterms:title "resources/templates/list" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/ResourcesTemplatesList"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category resources/templates/list`." .
<https://w3id.org/lmodel/mcp/result> a linkml:SlotDefinition ;
	linkml:any_of _:c14n197 , _:c14n259 , _:c14n47 , _:c14n544 , _:c14n545 , _:c14n546 ;
	linkml:description "Common result fields." , "The response to a {@link SubscriptionsListenRequestsubscriptions/listen}\nrequest, signalling that the subscription has ended gracefully (for example,\nduring server shutdown). Because the listen stream is long-lived, this result\nis sent only when the server tears the subscription down; an abrupt transport\nclose carries no response. The result body is otherwise empty." , "The result returned by the server for a {@link CompleteRequestcompletion/complete} request." , "The result returned by the server for a {@link DiscoverRequestserver/discover} request." , "The result returned by the server for a {@link ListPromptsRequestprompts/list} request." , "The result returned by the server for a {@link ListResourceTemplatesRequestresources/templates/list} request." , "The result returned by the server for a {@link ListResourcesRequestresources/list} request." , "The result returned by the server for a {@link ListToolsRequesttools/list} request." , "What the request returned." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpCompleteResult> , <https://w3id.org/lmodel/mcp/McpDiscoverResult> , <https://w3id.org/lmodel/mcp/McpListPromptsResult> , <https://w3id.org/lmodel/mcp/McpListResourceTemplatesResult> , <https://w3id.org/lmodel/mcp/McpListResourcesResult> , <https://w3id.org/lmodel/mcp/McpListToolsResult> , <https://w3id.org/lmodel/mcp/McpResult> , <https://w3id.org/lmodel/mcp/McpSubscriptionsListenResult> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/result_type> a linkml:SlotDefinition ;
	skos:prefLabel "resultType" ;
	linkml:description "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpResultType> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/role> a linkml:SlotDefinition ;
	linkml:description "The sender or recipient of messages and data in a conversation." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpRole> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/roots> a linkml:SlotDefinition ;
	linkml:deprecated "Deprecated as of protocol version 2026-07-28 (SEP-2577). Remains in the specification for at least twelve months; see the deprecated features registry." ;
	linkml:description "Present if the client supports listing roots." , "Represents a root directory or file that the server can operate on." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/mcp/McpClientCapabilitiesRoots> , <https://w3id.org/lmodel/mcp/McpRoot> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/roots_list> dcterms:title "roots/list" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/RootsList"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category roots/list`." .
<https://w3id.org/lmodel/mcp/sampling> a linkml:SlotDefinition ;
	linkml:deprecated "Deprecated as of protocol version 2026-07-28 (SEP-2577). Remains in the specification for at least twelve months; see the deprecated features registry." ;
	linkml:description "Present if the client supports sampling from an LLM." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpClientCapabilitiesSampling> .
<https://w3id.org/lmodel/mcp/sampling_createmessage> dcterms:title "sampling/createMessage" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/SamplingCreatemessage"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category sampling/createMessage`." .
<https://w3id.org/lmodel/mcp/schema_dialect> a linkml:SlotDefinition ;
	skos:altLabel "$schema" ;
	linkml:description "The JSON Schema dialect the schema is written in." .
<https://w3id.org/lmodel/mcp/server_discover> dcterms:title "server/discover" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/ServerDiscover"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category server/discover`." .
<https://w3id.org/lmodel/mcp/size> a linkml:SlotDefinition ;
	linkml:description "The size of the raw resource content, in bytes (i.e., before base64 encoding or any tokenization), if known.\n\nThis can be used by Hosts to display file sizes and estimate context window usage." ;
	linkml:range <https://w3id.org/lmodel/mcp/integer> .
<https://w3id.org/lmodel/mcp/sizes> a linkml:SlotDefinition ;
	linkml:description "Optional array of strings that specify sizes at which the icon can be used.\nEach string should be in WxH format (e.g., `\"48x48\"`, `\"96x96\"`) or `\"any\"` for scalable formats like SVG.\n\nIf not provided, the client should assume that the icon can be used at any size." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/mcp/sparqlpath> dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
	linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/speed_priority> a linkml:SlotDefinition ;
	skos:prefLabel "speedPriority" ;
	linkml:description "How much to prioritize sampling speed (latency) when selecting a model. A\nvalue of 0 means speed is not important, while a value of 1 means speed is\nthe most important factor." ;
	linkml:maximum_value "1"^^linkml:\@id ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/mcp/float> .
<https://w3id.org/lmodel/mcp/src> a linkml:SlotDefinition ;
	linkml:description "A standard URI pointing to an icon resource. May be an HTTP/HTTPS URL or a\n`data:` URI with Base64-encoded image data.\n\nConsumers SHOULD take steps to ensure URLs serving icons are from the\nsame domain as the client/server or a trusted domain.\n\nConsumers SHOULD take appropriate precautions when consuming SVGs as they can contain\nexecutable JavaScript." ;
	linkml:range <https://w3id.org/lmodel/mcp/uri> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/stop_reason> a linkml:SlotDefinition ;
	skos:prefLabel "stopReason" ;
	linkml:description "The reason why sampling stopped, if known.\n\nStandard values:\n- `\"endTurn\"`: Natural end of the assistant's turn\n- `\"stopSequence\"`: A stop sequence was encountered\n- `\"maxTokens\"`: Maximum token limit was reached\n- `\"toolUse\"`: The model wants to use one or more tools\n\nThis field is an open string to allow for provider-specific stop reasons." .
<https://w3id.org/lmodel/mcp/stop_sequences> a linkml:SlotDefinition ;
	skos:prefLabel "stopSequences" ;
	linkml:description "Sequences at which the model should stop generating." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/mcp/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/structured_content> a linkml:SlotDefinition ;
	skos:prefLabel "structuredContent" ;
	linkml:description "An optional JSON value that represents the structured result of the tool call.\n\nThis can be any JSON value (object, array, string, number, boolean, or null)\nthat conforms to the tool's outputSchema if one is defined." , "An optional structured result value.\n\nThis can be any JSON value (object, array, string, number, boolean, or null).\nIf the tool defined an {@link Tool.outputSchema}, this SHOULD conform to that schema." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpJSONValue> .
<https://w3id.org/lmodel/mcp/subscribe> a linkml:SlotDefinition ;
	linkml:description "Whether this server supports subscribing to resource updates." ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> .
<https://w3id.org/lmodel/mcp/subscriptions_listen> dcterms:title "subscriptions/listen" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/SubscriptionsListen"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category subscriptions/listen`." .
<https://w3id.org/lmodel/mcp/supported> a linkml:SlotDefinition ;
	linkml:description "Protocol versions the server supports. The client should choose a\nmutually supported version from this list and retry." ;
	linkml:multivalued true ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/supported_versions> a linkml:SlotDefinition ;
	skos:prefLabel "supportedVersions" ;
	linkml:description "MCP Protocol Versions this server supports. The client should choose a\nversion from this list for use in subsequent requests." ;
	linkml:multivalued true ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/system_prompt> a linkml:SlotDefinition ;
	skos:prefLabel "systemPrompt" ;
	linkml:description "An optional system prompt the server wants to use for sampling. The client MAY modify or omit this prompt." .
<https://w3id.org/lmodel/mcp/temperature> a linkml:SlotDefinition ;
	linkml:description "The sampling temperature the server asks the model to use." ;
	linkml:range <https://w3id.org/lmodel/mcp/float> .
<https://w3id.org/lmodel/mcp/text> a linkml:SlotDefinition ;
	linkml:description "The text content of the message." , "The text of the item. This must only be set if the item can actually be represented as text (not binary data)." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/theme> a linkml:SlotDefinition ;
	linkml:description "Optional specifier for the theme this icon is designed for. `\"light\"` indicates\nthe icon is designed to be used with a light background, and `\"dark\"` indicates\nthe icon is designed to be used with a dark background.\n\nIf not provided, the client should assume the icon can be used with any theme." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpIconTheme> .
<https://w3id.org/lmodel/mcp/thisServer> linkml:deprecated "The `\"thisServer\"` and `\"allServers\"` values are deprecated as of protocol version 2025-11-25 (SEP-2596) and will be removed no later than the Sampling feature itself (SEP-2577). Omit this field or use `\"none\"`." .
<https://w3id.org/lmodel/mcp/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/title> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/title"^^xsd:anyURI ;
	linkml:description "A name for people to read." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpBaseMetadata> , <https://w3id.org/lmodel/mcp/McpBooleanSchema> , <https://w3id.org/lmodel/mcp/McpImplementation> , <https://w3id.org/lmodel/mcp/McpLegacyTitledEnumSchema> , <https://w3id.org/lmodel/mcp/McpNumberSchema> , <https://w3id.org/lmodel/mcp/McpPrompt> , <https://w3id.org/lmodel/mcp/McpPromptArgument> , <https://w3id.org/lmodel/mcp/McpPromptReference> , <https://w3id.org/lmodel/mcp/McpResource> , <https://w3id.org/lmodel/mcp/McpResourceLink> , <https://w3id.org/lmodel/mcp/McpResourceTemplate> , <https://w3id.org/lmodel/mcp/McpStringSchema> , <https://w3id.org/lmodel/mcp/McpTitledMultiSelectEnumSchema> , <https://w3id.org/lmodel/mcp/McpTitledMultiSelectEnumSchemaItemsAnyOf> , <https://w3id.org/lmodel/mcp/McpTitledSingleSelectEnumSchema> , <https://w3id.org/lmodel/mcp/McpTitledSingleSelectEnumSchemaOneOf> , <https://w3id.org/lmodel/mcp/McpTool> , <https://w3id.org/lmodel/mcp/McpToolAnnotations> , <https://w3id.org/lmodel/mcp/McpUntitledMultiSelectEnumSchema> , <https://w3id.org/lmodel/mcp/McpUntitledSingleSelectEnumSchema> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpUntitledSingleSelectEnumSchema> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/tool_choice> a linkml:SlotDefinition ;
	skos:prefLabel "toolChoice" ;
	linkml:description "Controls how the model uses tools.\nThe client MUST return an error if this field is provided but {@link ClientCapabilities.sampling.tools} is not declared.\nDefault is `{ mode: \"auto\" }`." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpToolChoice> .
<https://w3id.org/lmodel/mcp/tool_use_id> a linkml:SlotDefinition ;
	skos:prefLabel "toolUseId" ;
	linkml:description "The ID of the tool use this result corresponds to.\n\nThis MUST match the ID from a previous {@link ToolUseContent}." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/tools> a linkml:SlotDefinition ;
	linkml:description "Definition for a tool the client can call." , "Present if the server offers any tools to call." , "Tools that the model may use during generation.\nThe client MUST return an error if this field is provided but {@link ClientCapabilities.sampling.tools} is not declared." , "Whether the client supports tool use via `tools` and `toolChoice` parameters." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/mcp/McpJSONObject> , <https://w3id.org/lmodel/mcp/McpServerCapabilitiesTools> , <https://w3id.org/lmodel/mcp/McpTool> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/tools_call> dcterms:title "tools/call" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/ToolsCall"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category tools/call`." .
<https://w3id.org/lmodel/mcp/tools_list> dcterms:title "tools/list" ;
