<https://w3id.org/lmodel/mcp/mcpToolAnnotations__destructive_hint> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "destructiveHint" ;
	linkml:description "If true, the tool may perform destructive updates to its environment.\nIf false, the tool performs only additive updates.\n\n(This property is meaningful only when `readOnlyHint == false`)\n\nDefault: true" ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpToolAnnotations> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpToolAnnotations> ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/destructiveHint"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpToolAnnotations__idempotent_hint> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "idempotentHint" ;
	linkml:description "If true, calling the tool repeatedly with the same arguments\nwill have no additional effect on its environment.\n\n(This property is meaningful only when `readOnlyHint == false`)\n\nDefault: false" ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpToolAnnotations> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpToolAnnotations> ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/idempotentHint"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpToolAnnotations__open_world_hint> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "openWorldHint" ;
	linkml:description "If true, this tool may interact with an \"open world\" of external\nentities. If false, the tool's domain of interaction is closed.\nFor example, the world of a web search tool is open, whereas that\nof a memory tool is not.\n\nDefault: true" ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpToolAnnotations> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpToolAnnotations> ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/openWorldHint"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpToolAnnotations__read_only_hint> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "readOnlyHint" ;
	linkml:description "If true, the tool does not modify its environment.\n\nDefault: false" ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpToolAnnotations> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpToolAnnotations> ;
	linkml:range <https://w3id.org/lmodel/mcp/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/readOnlyHint"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpToolChoice__mode> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "mode" ;
	linkml:description "Controls the tool use ability of the model:\n- `\"auto\"`: Model decides whether to use tools (default)\n- `\"required\"`: Model MUST use at least one tool before completing\n- `\"none\"`: Model MUST NOT use any tools" ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpToolChoice> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpToolChoice> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpToolChoiceMode> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/mode"^^xsd:anyURI .
