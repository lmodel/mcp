	linkml:slot_uri "https://w3id.org/lmodel/mcp/enum"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcp_client_capabilities> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/clientCapabilities" ;
	linkml:description "The client's capabilities for this specific request. Required.\n\nCapabilities are declared per-request rather than once at initialization;\nan empty object means the client supports no optional capabilities.\nServers MUST NOT infer capabilities from prior requests." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpClientCapabilities> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/mcp_client_info> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/clientInfo" ;
	linkml:description "Identifies the client software making the request. Clients SHOULD\ninclude this field on every request unless specifically configured not\nto do so.\n\nThe {@link Implementation} schema requires `name` and `version`; other\nfields are optional.\n\nThe value is self-reported by the client and is not verified by the\nprotocol. It is intended for display, logging, and debugging. Servers\nSHOULD NOT use it to change their behavior, and SHOULD NOT rely on it for\nsecurity decisions." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpImplementation> .
<https://w3id.org/lmodel/mcp/mcp_log_level> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/logLevel" ;
	linkml:deprecated "Deprecated as of protocol version 2026-07-28 (SEP-2577). Remains in the specification for at least twelve months; see the deprecated features registry." ;
	linkml:description "The desired log level for this request. Optional.\n\nIf absent, the server MUST NOT send any {@link LoggingMessageNotificationnotifications/message}\nnotifications for this request. The client opts in to log messages by\nexplicitly setting a level. Replaces the former `logging/setLevel` RPC." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpLoggingLevel> .
<https://w3id.org/lmodel/mcp/mcp_protocol_version> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/protocolVersion" ;
	linkml:description "The MCP Protocol Version being used for this request. Required.\n\nFor the HTTP transport, this value MUST match the `MCP-Protocol-Version`\nheader; otherwise the server MUST return a `400 Bad Request`. If the\nserver does not support the requested version, it MUST return an\n{@link UnsupportedProtocolVersionError}." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/mcp_server_info> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/serverInfo" ;
	linkml:description "Identifies the server software producing the response. Servers SHOULD\ninclude this field on every response unless specifically configured not\nto do so.\n\nThe {@link Implementation} schema requires `name` and `version`; other\nfields are optional.\n\nThe value is self-reported by the server and is not verified by the\nprotocol. It is intended for display, logging, and debugging. Clients\nSHOULD NOT use it to change their behavior, and SHOULD NOT rely on it for\nsecurity decisions." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpImplementation> .
<https://w3id.org/lmodel/mcp/mcp_subscription_id> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/subscriptionId" ;
	linkml:any_of _:c14n542 , _:c14n543 , _:c14n549 , _:c14n550 ;
	linkml:description "Identifies the subscription stream a notification was delivered on. The\nserver MUST include this key on every notification delivered via a\n{@link SubscriptionsListenRequestsubscriptions/listen} stream, so the\nclient can correlate the notification with the originating subscription.\nThe key is absent on notifications not delivered via a subscription\nstream (e.g. progress notifications for an in-flight request), which is\nwhy it is optional here.\n\nThe value is the JSON-RPC ID of the `subscriptions/listen` request that\nopened the stream." , "Identifies the subscription stream this response closes, so the client can\ncorrelate it with the originating subscription — mirroring the same key on\nthe stream's notifications. The value is the JSON-RPC ID of the\n`subscriptions/listen` request that opened the stream (and equals this\nresponse's `id`)." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/message> a linkml:SlotDefinition ;
	linkml:description "A short description of the error. The message SHOULD be limited to a concise single sentence." , "An optional message describing the current progress." , "The message to present to the user describing what information is being requested." , "The message to present to the user explaining why the interaction is needed." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/messages> a linkml:SlotDefinition ;
	linkml:description "Describes a message issued to or received from an LLM API." , "Describes a message returned as part of a prompt.\n\nThis is similar to {@link SamplingMessage}, but also supports the embedding of\nresources from the MCP server." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/mcp/McpPromptMessage> , <https://w3id.org/lmodel/mcp/McpSamplingMessage> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/meta> a linkml:SlotDefinition ;
	skos:prefLabel "_meta" ;
	linkml:description "Extends {@link MetaObject} with additional notification-specific fields. All key naming rules from `MetaObject` apply." , "Extends {@link MetaObject} with additional request-specific fields. All key naming rules from `MetaObject` apply." , "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply." , "Extends {@link ResultMetaObject} with the subscription-stream identifier carried by a\n{@link SubscriptionsListenResult}. All key naming rules from `MetaObject` apply." , "Optional metadata about the tool result. Clients SHOULD preserve this field when\nincluding tool results in subsequent sampling requests to enable caching optimizations." , "Optional metadata about the tool use. Clients SHOULD preserve this field when\nincluding tool uses in subsequent sampling requests to enable caching optimizations." , "Represents the contents of a `_meta` field, which clients and servers use to attach additional metadata to their interactions.\n\nCertain key names are reserved by MCP for protocol-level metadata; implementations MUST NOT make assumptions about values at these keys. Additionally, specific schema definitions may reserve particular names for purpose-specific metadata, as declared in those definitions.\n\nValid keys have two segments:\n\n**Prefix:**\n- Optional — if specified, MUST be a series of _labels_ separated by dots (`.`), followed by a slash (`/`).\n- Labels MUST start with a letter and end with a letter or digit. Interior characters may be letters, digits, or hyphens (`-`).\n- Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).\n- Any prefix where the second label is `modelcontextprotocol` or `mcp` is **reserved** for MCP use. For example: `io.modelcontextprotocol/`, `dev.mcp/`, `org.modelcontextprotocol.api/`, and `com.mcp.tools/` are all reserved. However, `com.example.mcp/` is NOT reserved, as the second label is `example`.\n\n**Name:**\n- Unless empty, MUST start and end with an alphanumeric character (`[a-z0-9A-Z]`).\n- Interior characters may be alphanumeric, hyphens (`-`), underscores (`_`), or dots (`.`)." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpMetaObject> , <https://w3id.org/lmodel/mcp/McpNotificationMetaObject> , <https://w3id.org/lmodel/mcp/McpRequestMetaObject> , <https://w3id.org/lmodel/mcp/McpResultMetaObject> , <https://w3id.org/lmodel/mcp/McpSubscriptionsListenResultMetaObject> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/metadata> a linkml:SlotDefinition ;
	linkml:description "Optional metadata to pass through to the LLM provider. The format of this metadata is provider-specific." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpJSONObject> .
<https://w3id.org/lmodel/mcp/method> a linkml:SlotDefinition ;
	linkml:description "The method's name, always `completion/complete`." , "The method's name, always `elicitation/create`." , "The method's name, always `notifications/cancelled`." , "The method's name, always `notifications/message`." , "The method's name, always `notifications/progress`." , "The method's name, always `notifications/prompts/list_changed`." , "The method's name, always `notifications/resources/list_changed`." , "The method's name, always `notifications/resources/updated`." , "The method's name, always `notifications/subscriptions/acknowledged`." , "The method's name, always `notifications/tools/list_changed`." , "The method's name, always `prompts/get`." , "The method's name, always `prompts/list`." , "The method's name, always `resources/list`." , "The method's name, always `resources/read`." , "The method's name, always `resources/templates/list`." , "The method's name, always `roots/list`." , "The method's name, always `sampling/createMessage`." , "The method's name, always `server/discover`." , "The method's name, always `subscriptions/listen`." , "The method's name, always `tools/call`." , "The method's name, always `tools/list`." , "The name of the method." ;
	linkml:equals_string "completion/complete" , "elicitation/create" , "notifications/cancelled" , "notifications/message" , "notifications/progress" , "notifications/prompts/list_changed" , "notifications/resources/list_changed" , "notifications/resources/updated" , "notifications/subscriptions/acknowledged" , "notifications/tools/list_changed" , "prompts/get" , "prompts/list" , "resources/list" , "resources/read" , "resources/templates/list" , "roots/list" , "sampling/createMessage" , "server/discover" , "subscriptions/listen" , "tools/call" , "tools/list" ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/mime_type> a linkml:SlotDefinition ;
	skos:prefLabel "mimeType" ;
	linkml:description "Optional MIME type override if the source MIME type is missing or generic.\nFor example: `\"image/png\"`, `\"image/jpeg\"`, or `\"image/svg+xml\"`." , "The MIME type for all resources that match this template. This should only be included if all resources matching this template have the same type." , "The MIME type of the audio. Different providers may support different audio types." , "The MIME type of the image. Different providers may support different image types." , "The MIME type of this resource, if known." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/min_items> a linkml:SlotDefinition ;
	skos:prefLabel "minItems" ;
	linkml:description "Minimum number of items to select." ;
	linkml:range <https://w3id.org/lmodel/mcp/integer> .
<https://w3id.org/lmodel/mcp/min_length> a linkml:SlotDefinition ;
	skos:prefLabel "minLength" ;
	linkml:description "The fewest characters the field accepts." ;
	linkml:range <https://w3id.org/lmodel/mcp/integer> .
<https://w3id.org/lmodel/mcp/minimum> a linkml:SlotDefinition ;
	linkml:description "The smallest value the field accepts." ;
	linkml:range <https://w3id.org/lmodel/mcp/float> .
<https://w3id.org/lmodel/mcp/mode> a linkml:SlotDefinition ;
	linkml:description "Controls the tool use ability of the model:\n- `\"auto\"`: Model decides whether to use tools (default)\n- `\"required\"`: Model MUST use at least one tool before completing\n- `\"none\"`: Model MUST NOT use any tools" , "The elicitation mode." ;
	linkml:equals_string "form" , "url" ;
	linkml:range <https://w3id.org/lmodel/mcp/McpToolChoiceMode> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/model> a linkml:SlotDefinition ;
	linkml:description "The name of the model that generated the message." ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/model_preferences> a linkml:SlotDefinition ;
	skos:prefLabel "modelPreferences" ;
	linkml:description "The server's preferences for which model to select. The client MAY ignore these preferences." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpModelPreferences> .
<https://w3id.org/lmodel/mcp/multi_round_trip> dcterms:title "Multi Round-Trip" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/MultiRoundTrip"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category Multi Round-Trip`." .
<https://w3id.org/lmodel/mcp/name> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/name"^^xsd:anyURI ;
	linkml:description "The name a program uses to refer to the thing." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpBaseMetadata> , <https://w3id.org/lmodel/mcp/McpCallToolRequestParams> , <https://w3id.org/lmodel/mcp/McpCompleteRequestParamsArgument> , <https://w3id.org/lmodel/mcp/McpGetPromptRequestParams> , <https://w3id.org/lmodel/mcp/McpImplementation> , <https://w3id.org/lmodel/mcp/McpModelHint> , <https://w3id.org/lmodel/mcp/McpPrompt> , <https://w3id.org/lmodel/mcp/McpPromptArgument> , <https://w3id.org/lmodel/mcp/McpPromptReference> , <https://w3id.org/lmodel/mcp/McpResource> , <https://w3id.org/lmodel/mcp/McpResourceLink> , <https://w3id.org/lmodel/mcp/McpResourceTemplate> , <https://w3id.org/lmodel/mcp/McpRoot> , <https://w3id.org/lmodel/mcp/McpTool> , <https://w3id.org/lmodel/mcp/McpToolUseContent> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpToolUseContent> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/ncname> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "NCName" ;
	linkml:definition_uri "https://w3id.org/linkml/Ncname"^^xsd:anyURI ;
	linkml:description "Prefix part of CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/next_cursor> a linkml:SlotDefinition ;
	skos:prefLabel "nextCursor" ;
	linkml:description "An opaque token representing the pagination position after the last returned result.\nIf present, there may be more results available." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpCursor> .
<https://w3id.org/lmodel/mcp/nodeidentifier> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "NodeIdentifier" ;
	linkml:definition_uri "https://w3id.org/linkml/Nodeidentifier"^^xsd:anyURI ;
	linkml:description "A URI, CURIE or BNODE that represents a node in a model." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/ns/shex#nonLiteral"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/notifications> a linkml:SlotDefinition ;
	linkml:description "The notifications the client opts in to on this stream. The server\n**MUST NOT** send notification types the client has not explicitly\nrequested." , "The subset of requested notification types the server agreed to honor.\nOnly includes notification types the server actually supports; if the\nclient requested an unsupported type (e.g., `promptsListChanged` when\nthe server has no prompts), it is omitted from this set." ;
	linkml:range <https://w3id.org/lmodel/mcp/McpSubscriptionFilter> ;
	linkml:required true .
<https://w3id.org/lmodel/mcp/notifications_cancelled> dcterms:title "notifications/cancelled" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/NotificationsCancelled"^^xsd:anyURI ;
	linkml:description "The definitions schema.ts tags `@category notifications/cancelled`." .
<https://w3id.org/lmodel/mcp/notifications_message> dcterms:title "notifications/message" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
