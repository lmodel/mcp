<https://w3id.org/lmodel/mcp/mcpCreateMessageResult__stop_reason> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "stopReason" ;
	linkml:description "The reason why sampling stopped, if known.\n\nStandard values:\n- `\"endTurn\"`: Natural end of the assistant's turn\n- `\"stopSequence\"`: A stop sequence was encountered\n- `\"maxTokens\"`: Maximum token limit was reached\n- `\"toolUse\"`: The model wants to use one or more tools\n\nThis field is an open string to allow for provider-specific stop reasons." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpCreateMessageResult> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpCreateMessageResult> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/stopReason"^^xsd:anyURI .
