<https://w3id.org/lmodel/mcp/mcpResult__result_type> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "resultType" ;
	linkml:description "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpResult> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpResult> ;
