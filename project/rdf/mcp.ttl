<https://w3id.org/lmodel/mcp/mcpIcon__mime_type> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "mimeType" ;
	linkml:description "Optional MIME type override if the source MIME type is missing or generic.\nFor example: `\"image/png\"`, `\"image/jpeg\"`, or `\"image/svg+xml\"`." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpIcon> ;
