	linkml:range <https://w3id.org/lmodel/mcp/integer> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/maxItems"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpUntitledMultiSelectEnumSchema__min_items> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "minItems" ;
	linkml:description "Minimum number of items to select." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpUntitledMultiSelectEnumSchema> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpUntitledMultiSelectEnumSchema> ;
	linkml:range <https://w3id.org/lmodel/mcp/integer> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/minItems"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpUntitledSingleSelectEnumSchema__default> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "default" ;
	linkml:description "Optional default value." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpUntitledSingleSelectEnumSchema> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpUntitledSingleSelectEnumSchema> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
