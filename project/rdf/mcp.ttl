<https://w3id.org/lmodel/mcp/McpSubscriptionsListenResult> OIO:inSubset <https://w3id.org/lmodel/mcp/subscriptions_listen> ;
	a linkml:ClassDefinition ;
	skos:exactMatch "mcp_schema:SubscriptionsListenResult"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/mcp/meta> , <https://w3id.org/lmodel/mcp/result_type> ;
	linkml:class_uri "https://w3id.org/lmodel/mcp/McpSubscriptionsListenResult"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/mcp/McpSubscriptionsListenResult"^^xsd:anyURI ;
	linkml:description "The response to a {@link SubscriptionsListenRequestsubscriptions/listen}\nrequest, signalling that the subscription has ended gracefully (for example,\nduring server shutdown). Because the listen stream is long-lived, this result\nis sent only when the server tears the subscription down; an abrupt transport\nclose carries no response. The result body is otherwise empty." ;
	linkml:extra_slots _:c14n450 ;
