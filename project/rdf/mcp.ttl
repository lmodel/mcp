	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/default"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpUntitledMultiSelectEnumSchema__items> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "items" ;
	linkml:description "Schema for the array items." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpUntitledMultiSelectEnumSchema> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpUntitledMultiSelectEnumSchema> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpUntitledMultiSelectEnumSchemaItems> ;
