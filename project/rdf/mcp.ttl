	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpUnsupportedProtocolVersionErrorErrorData> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/supported"^^xsd:anyURI .
