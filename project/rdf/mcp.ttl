<https://w3id.org/lmodel/mcp/mcpReadResourceResult__cache_scope> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "cacheScope" ;
	linkml:description "Indicates the intended scope of the cached response, analogous to HTTP\n`Cache-Control: public` vs `Cache-Control: private`.\n\n- `\"public\"`: The response does not contain user-specific data. Any\n  client or intermediary (e.g., shared gateway, caching proxy) MAY cache\n  the response and serve it across authorization contexts.\n- `\"private\"`: The response MAY be cached and reused only within the\n  same authorization context. Caches MUST NOT be shared across\n  authorization contexts (e.g., a different access token requires a\n  different cache)." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpCacheScope> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/cacheScope"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpReadResourceResult__contents> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "contents" ;
	linkml:any_of _:c14n216 , _:c14n396 ;
	linkml:description "The contents of the resource that was read." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:range <https://w3id.org/lmodel/mcp/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/contents"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpReadResourceResult__meta> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "_meta" ;
	linkml:description "Extends {@link MetaObject} with additional result-specific fields. All key naming rules from `MetaObject` apply." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpResultMetaObject> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/_meta"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpReadResourceResult__result_type> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "resultType" ;
	linkml:description "Indicates the type of the result, which allows the client to determine\nhow to parse the result object.\n\nServers implementing this protocol version MUST include this field.\nFor backward compatibility, when a client receives a result from a\nserver implementing an earlier protocol version (which does not include\n`resultType`), the client MUST treat the absent field as `\"complete\"`." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpResultType> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/resultType"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpReadResourceResult__ttl_ms> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "ttlMs" ;
	linkml:description "A hint from the server indicating how long (in milliseconds) the\nclient MAY cache this response before re-fetching. Semantics are\nanalogous to HTTP Cache-Control max-age.\n\n- If 0, The response SHOULD be considered immediately stale,\n  The client MAY re-fetch every time the result is needed.\n- If positive, the client SHOULD consider the result fresh for this many\n  milliseconds after receiving the response." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpReadResourceResult> ;
	linkml:range <https://w3id.org/lmodel/mcp/integer> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/ttlMs"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpRequestMetaObject__mcp_client_capabilities> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/clientCapabilities" ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "mcp_client_capabilities" ;
	linkml:description "The client's capabilities for this specific request. Required.\n\nCapabilities are declared per-request rather than once at initialization;\nan empty object means the client supports no optional capabilities.\nServers MUST NOT infer capabilities from prior requests." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpRequestMetaObject> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpRequestMetaObject> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpClientCapabilities> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/mcp_client_capabilities"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpRequestMetaObject__mcp_client_info> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/clientInfo" ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "mcp_client_info" ;
	linkml:description "Identifies the client software making the request. Clients SHOULD\ninclude this field on every request unless specifically configured not\nto do so.\n\nThe {@link Implementation} schema requires `name` and `version`; other\nfields are optional.\n\nThe value is self-reported by the client and is not verified by the\nprotocol. It is intended for display, logging, and debugging. Servers\nSHOULD NOT use it to change their behavior, and SHOULD NOT rely on it for\nsecurity decisions." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpRequestMetaObject> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpRequestMetaObject> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpImplementation> ;
	linkml:slot_uri "https://w3id.org/lmodel/mcp/mcp_client_info"^^xsd:anyURI .
<https://w3id.org/lmodel/mcp/mcpRequestMetaObject__mcp_log_level> a linkml:SlotDefinition ;
	skos:altLabel "io.modelcontextprotocol/logLevel" ;
	skos:inScheme "https://w3id.org/lmodel/mcp"^^xsd:anyURI ;
	skos:prefLabel "mcp_log_level" ;
	linkml:deprecated "Deprecated as of protocol version 2026-07-28 (SEP-2577). Remains in the specification for at least twelve months; see the deprecated features registry." ;
	linkml:description "The desired log level for this request. Optional.\n\nIf absent, the server MUST NOT send any {@link LoggingMessageNotificationnotifications/message}\nnotifications for this request. The client opts in to log messages by\nexplicitly setting a level. Replaces the former `logging/setLevel` RPC." ;
	linkml:domain_of <https://w3id.org/lmodel/mcp/McpRequestMetaObject> ;
	linkml:owner <https://w3id.org/lmodel/mcp/McpRequestMetaObject> ;
	linkml:range <https://w3id.org/lmodel/mcp/McpLoggingLevel> ;
